---
// The stored theme, applied before the first paint. With no stored choice nothing is set and the stylesheet follows prefers-color-scheme, which is the system theme.

import Base from '../../layouts/Base.astro';
import BgArt from '../../components/BgArt.astro';
import ToTop from '../../components/ToTop.astro';
import Icon from '../../components/Icon.astro';
import JsonLd from '../../components/JsonLd.astro';
import { ENGLISH } from '../../i18n/langs';

Astro.locals.lang = ENGLISH;

const ld0 = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://tmplayer.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Security",
      "item": "https://tmplayer.org/security/"
    }
  ]
};
---
<Base path="/security/" title="Is TMPlayer safe? Open source, built in public, checkable" description="TMPlayer is open source under GPL-3.0, built by GitHub Actions from the tagged source, with a SHA-256 for every file. How to check a download, and how to report a problem.">
  <Fragment slot="head">
    <JsonLd data={ld0} />
  </Fragment>
<!-- Decorative background art, hidden from assistive technology and still under reduced motion. -->
<BgArt />

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="TMPlayer home">
      <img class="brand-mark" src="/favicon.svg" width="32" height="32" alt="" decoding="async">
      <span class="brand-name">TMPlayer</span>
    </a>

    <nav class="nav-links" id="site-nav" aria-label="Primary">
        <a href="/">Home</a>
        <a href="/features/">Features</a>
        <a href="/download/">Download</a>
        <a href="/install/">Install</a>
        <a class="only-menu" href="/android-tv/">Android TV</a>
        <a href="/faq/">Questions</a>
      </nav>

    <div class="nav">
      <a class="nav-icon" href="https://github.com/dracu-lah/TMPlayer" rel="noopener" aria-label="TMPlayer on GitHub">
        <Icon name="github" />
        <span class="nav-icon-count is-loading" data-count="stars" data-count-skeleton aria-hidden="true"></span>
      </a>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme">
        <Icon name="sun" />
        <Icon name="moon" />
      </button>
