---
// One page per release, so a search for "TMPlayer 1.25.0" lands on its notes.
import Shell from '../../../components/changelog/Shell.astro';
import PageHead from '../../../components/PageHead.astro';
import SponsorOffer from '../../../components/SponsorOffer.astro';
import Icon from '../../../components/Icon.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { breadcrumb } from '../../../components/breadcrumb';
import { ENGLISH } from '../../../i18n/langs';
import { PAGE_URL, SITE, hasMac, humanDate, notesHtml, releaseUrl, releases, summary, type Release } from '../../../lib/releases';

export function getStaticPaths() {
  return releases.map((r, i) => ({
    params: { version: r.version },
    props: { r, newer: releases[i - 1], older: releases[i + 1], latest: i === 0 },
  }));
}

interface Props { r: Release; newer?: Release; older?: Release; latest: boolean }
const { r, newer, older, latest } = Astro.props;
Astro.locals.lang = ENGLISH;

const v = r.version;
const url = releaseUrl(v);
const description = summary(r);
const post = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: `TMPlayer ${v}`,
  description,
  url,
  mainEntityOfPage: url,
  datePublished: r.iso,
  dateModified: r.iso,
  inLanguage: 'en',
  image: `${SITE}/og.png?v=4`,
  author: { '@type': 'Person', name: 'dracu-lah', url: 'https://github.com/dracu-lah' },
  publisher: {
    '@type': 'Organization', name: 'TMPlayer', url: `${SITE}/`,
    logo: { '@type': 'ImageObject', url: `${SITE}/icon-512.png` },
  },
  isPartOf: { '@type': 'Blog', name: 'TMPlayer releases', url: PAGE_URL },
  about: {
    '@type': 'SoftwareApplication', name: 'TMPlayer', softwareVersion: v,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: hasMac(v) ? 'Android, Android TV, Windows, macOS, Linux' : 'Android, Android TV, Windows, Linux',
    url: `${SITE}/`,
  },
};
const get = latest
  ? 'This is the newest release. Installed copies offer it on their own; a new install starts from the download page.'
  : "A newer release is out. Installed copies move straight to it, and its files are the ones the download page offers. This release's own files stay on GitHub.";
---
<Shell path={`/changelog/${v}`} title={`TMPlayer ${v} release notes: what's new`} description={description} ogType="article" publishedTime={r.iso}>
  <Fragment slot="head">
    <JsonLd data={breadcrumb(['Changelog', PAGE_URL], [`TMPlayer ${v}`, url])} />
    <JsonLd data={post} />
  </Fragment>

  <PageHead>
    <Fragment slot="crumbs"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/changelog/">Changelog</a><span aria-hidden="true">/</span>{v}</Fragment>
    <Fragment slot="title">TMPlayer <em>{v}</em></Fragment>
    <Fragment slot="lede">Released <time datetime={r.day}>{humanDate(r.date)}</time>, for Android TV, Android phones, Windows{hasMac(v) ? ', macOS' : ''} and Linux.</Fragment>
  </PageHead>

<Icon name="wave" />

  <section class="band band-tonal" aria-label="Release notes">
    <div class="wrap">
      <article class="changelog-entry release-article">
        <h2 class="release-notes-h">What changed</h2>
        <div class="changelog-notes">
<Fragment set:html={notesHtml(r, ' '.repeat(8))} />
        </div>
      </article>

      <div class="changelog-entry release-get">
        <h2 class="release-notes-h">Get it</h2>
        <p class="changelog-notes">{get}</p>
        <div class="page-actions">
          <a class="btn btn-filled" href="/download/">{latest ? 'Download TMPlayer' : 'Download the latest'}</a>
          <a class="btn btn-outline" href={r.url} rel="noopener">The files on GitHub</a>
          <a class="btn btn-outline" href="/changelog/feed.xml" type="application/rss+xml"><Icon name="rss" /> Follow by RSS</a>
        </div>
      </div>
<SponsorOffer release lede={`Glad ${v} reached you.`} />
{(older || newer) && (
      <nav class="release-nav" aria-label="Other releases">
        {older && <a class="release-nav-older" href={`/changelog/${older.version}`} rel="prev"><span class="muted small">Older</span>TMPlayer {older.version}</a>}
        {newer && <a class="release-nav-newer" href={`/changelog/${newer.version}`} rel="next"><span class="muted small">Newer</span>TMPlayer {newer.version}</a>}
      </nav>
)}

      <p class="muted small section-note changelog-foot"><a href="/changelog/">Every release</a>, newest first.</p>
    </div>
  </section>
</Shell>
