---
// /alternatives/<app>/: TMPlayer next to one other way of watching Telegram videos on a TV, one
// page per app people search for by name. English only: every page is src/data/vs.json (which
// bands, rows, cards, steps and questions it has, and its sources) and its words are the vs.<id>.*
// strings in en.json, falling back to vs.common.* for the ones the pages share. vs.* does not
// count towards a language's share (src/i18n/t.ts), so a new page never unpublishes a language;
// a translated copy would need its own hreflang wiring first.
//
// Facts only. Every claim about the other app comes from a page in its sources, as it read on the
// day in `checked`; where a listing does not say, the cell says "Not stated". Links to other apps
// and sites are nofollow: naming an app is not recommending it. TMPlayer is never called by the
// other app's name, nor described as connected with it.
import Base from '../../layouts/Base.astro';
import BgArt from '../../components/BgArt.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToTop from '../../components/ToTop.astro';
import PageHead from '../../components/PageHead.astro';
import JsonLd from '../../components/JsonLd.astro';
import { breadcrumb } from '../../components/breadcrumb';
import Band from '../../components/Band.astro';
import Cards from '../../components/Cards.astro';
import Card from '../../components/Card.astro';
import LinkCard from '../../components/LinkCard.astro';
import DeviceShot from '../../components/DeviceShot.astro';
import FaqItem from '../../components/FaqItem.astro';
import Steps from '../../components/Steps.astro';
import Step from '../../components/Step.astro';
import Action from '../../components/guides/Action.astro';
import MoreHelp from '../../components/guides/MoreHelp.astro';
import StarBand from '../../components/StarBand.astro';
import T from '../../components/T.astro';
import data from '../../data/vs.json';
import { ENGLISH } from '../../i18n/langs';
import { english, format, text } from '../../i18n/t';
import { rich } from '../../lib/rich';
import { formatDay, lastmod } from '../../lib/lastmod';
import { releases } from '../../lib/releases';

interface Section { id: string; h: string; p?: string[]; list?: string[]; cards?: string[] }
interface ShotSpec { device: 'tv' | 'phone' | 'desktop'; src: string; light?: string; width: number; height: number; alt: string; caption: string }
interface Page {
  id: string;
  slug: string;
  name: string;
  listing: string;
  sections: Section[];
  rows: string[];
  better: string[];
  fine: string[];
  steps: string[];
  faq: string[];
  shots: ShotSpec[];
  sources: { k: string; url: string }[];
}

export function getStaticPaths() {
  return (data.pages as Page[]).map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Page };
const lang = ENGLISH;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const path = `/alternatives/${p.slug}/`;
const latest = releases[0];
const vars = {
  name: p.name,
  date: formatDay(lang, data.checked),
  version: latest.version,
  released: formatDay(lang, latest.day),
};
// The page's own string, else the shared one: vs.tmp.better_open_p, then vs.common.better_open_p.
const key = (k: string) => (english[`vs.${p.id}.${k}`] !== undefined ? `vs.${p.id}.${k}` : `vs.common.${k}`);
const r = (k: string) => rich(lang, key(k), vars, { a1: '/legal/' });
const f = (k: string) => format(lang, key(k), vars);
// The bands alternate tonal and plain down the page: the page's own sections first, then the
// eight every page has, in this order.
const after = ['compare', 'better', 'fine', 'switch', 'questions', 'sources', 'others', 'more'];
const tonal = (band: string) => (p.sections.length + after.indexOf(band)) % 2 === 0;
// Three cards a row for three or six of them, two a row for four, so no row is left with one.
const grid = (n: number) => (n % 3 === 0 ? 'card-grid card-grid-3' : 'card-grid');
const has =(k: string) => english[`vs.${p.id}.${k}`] !== undefined;
const them = has('col_them') ? t(key('col_them')) : p.name;

// A table row: its label, the other app's cell, TMPlayer's cell.
const rows = p.rows.map((row) => [
  has(`${row}_row`) ? t(key(`${row}_row`)) : t(`vs.common.row_${row}`),
  r(`${row}_them`),
  has(`${row}_us`) ? r(`${row}_us`) : r(`us_${row}`),
]);

// The other comparisons, for the last band: every page but this one.
const others = (data.pages as Page[]).filter((o) => o.id !== p.id);
const cardTitle = (o: Page) => (o.id === 'telegram' ? t('alternatives.one_telegram_h') : o.name);

const title = t(key('title'));
const description = t(key('description'));
const webPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: `https://tmplayer.org${path}`,
  dateModified: lastmod(path),
  inLanguage: 'en',
  about: [
    { '@type': 'SoftwareApplication', name: 'TMPlayer', url: 'https://tmplayer.org/' },
    { '@type': 'SoftwareApplication', name: p.name, url: p.listing },
  ],
};
---
<Base path={path} title={title} description={description} getBar>
  <Fragment slot="head">
    <JsonLd data={breadcrumb(['Alternatives', '/alternatives/'], [english[key('crumb')], path])} />
    <JsonLd data={webPage} />
  </Fragment>
{/* Decorative background art, hidden from assistive technology and still under reduced motion. */}
<BgArt />

<Header page="alternatives" />

<main id="main">

  <PageHead lede={t(key('lede'))} updated={path}>
    <Fragment slot="crumbs"><a href="/">{t('common.home')}</a><span aria-hidden="true">/</span><a href="/alternatives/">{t('alternatives.crumb')}</a><span aria-hidden="true">/</span>{t(key('crumb'))}</Fragment>
    <T slot="title" k={key('h1')}><em slot="em1">{t(key('h1__em1'))}</em></T>
    <Fragment slot="actions">
      <Action filled href="/download/">{t('home.download_tmplayer')}</Action>
      <Action href="#compare">{t('alternatives.see_the_table')}</Action>
    </Fragment>
  </PageHead>

  {p.sections.map((s, i) => (
    <Band wave tonal={i % 2 === 0} id={s.id} title={f(s.h)}>
      {(s.p || s.list) && (
        <div class="section-body prose-band" data-reveal>
          {s.p?.map((k) => <p set:html={r(k)} />)}
          {s.list && <ul class="fact-list">{s.list.map((k) => <li set:html={r(k)} />)}</ul>}
        </div>
      )}
      {s.cards && (
        <div class="formats formats-3" data-reveal>
          {s.cards.map((c) => (
            <div class="format">
              <h3>{t(key(`${c}_h`))}</h3>
              <p set:html={r(`${c}_p`)} />
            </div>
          ))}
        </div>
      )}
    </Band>
  ))}

  <Band wave tonal={tonal('compare')} id="compare" title={f('table_h')} sub={f('table_sub')}>
    {/* Scrolls on its own on a phone, so it takes focus for the keyboard and is named by its
        caption for a screen reader. */}
    <div class="compare-wrap" role="region" aria-labelledby="vs-caption" tabindex="0" data-reveal>
      <table class="compare compare-vs">
        <caption id="vs-caption">{f('caption')}</caption>
        <thead>
          <tr>
            <th scope="col">{t('vs.common.col_what')}</th>
            <th scope="col">{them}</th>
            <th scope="col">{t('vs.common.col_tmplayer')}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(([label, other, ours]) => (
            <tr>
              <th scope="row">{label}</th>
              <td data-app={them} set:html={other} />
              <td data-app="TMPlayer" set:html={ours} />
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Band>

  <StarBand lede={t('android_tv.a_tv_app_outside_the')} />

  <Band wave tonal={tonal('better')} id="better" title={t('vs.common.better_h')}>
    <div class={grid(p.better.length)} data-reveal>
      {p.better.map((b) => <Card title={t(key(`better_${b}_h`))}><Fragment set:html={r(`better_${b}_p`)} /></Card>)}
    </div>
  </Band>

  <Band wave tonal={tonal('fine')} id="fine" title={f('fine_h')}>
    <div class={grid(p.fine.length)} data-reveal>
      {p.fine.map((x) => <Card title={t(key(`fine_${x}_h`))}><Fragment set:html={r(`fine_${x}_p`)} /></Card>)}
    </div>
  </Band>

  <Band wave body tonal={tonal('switch')} id="switch" title={t('vs.common.switch_h')}>
    <Steps>
      {p.steps.map((s, i) => (
        <Step id={`switch-${i + 1}`} title={t(key(`step_${s}_h`))} p><Fragment set:html={r(`step_${s}_p`)} /></Step>
      ))}
    </Steps>
    <div class="shots alt-shots">
      {p.shots.map((s) => (
        <DeviceShot device={s.device} shot={{ src: s.src, light: s.light, alt: t(s.alt), width: s.width, height: s.height }}><Fragment set:html={rich(lang, s.caption)} /></DeviceShot>
      ))}
    </div>
  </Band>

  <Band wave tonal={tonal('questions')} id="questions" title={t('vs.common.faq_h')}>
    <div class="faq" data-reveal>
      {p.faq.map((f) => <FaqItem q={t(key(`faq_${f}_q`))} name="faq" id={`faq-${f}`}><Fragment set:html={r(`faq_${f}_a`)} /></FaqItem>)}
    </div>
  </Band>

  <Band wave tonal={tonal('sources')} id="sources" title={f('sources_h')}>
    <div class="section-body prose-band" data-reveal>
      <p set:html={r('sources_p')} />
      <ul class="fact-list">
        {p.sources.map((s) => <li><a href={s.url} rel="nofollow noopener">{t(key(s.k))}</a></li>)}
      </ul>
      <p class="muted small" set:html={r('unofficial')} />
    </div>
  </Band>

  <Band wave tonal={tonal('others')} id="others" title={t('vs.common.more_h')}>
    <Cards>
      {others.map((o) => <LinkCard href={`/alternatives/${o.slug}/`} icon="tv-card" title={cardTitle(o)} body={t(`alternatives.one_${o.id}`)} go={t('alternatives.one_go')} />)}
      <LinkCard href="/alternatives/" icon="play-card" title={t('common.telegram_tv_apps_compared')} body={t('vs.common.all_compared')} go={t('alternatives.see_the_table')} />
    </Cards>
  </Band>

  <MoreHelp tonal={tonal('more')} download={{ href: '/install/', label: t('download.how_to_install_it') }}>
    <T k="guide_no_casting.tmplayer_does_not_provide_media"><a href="/faq/" slot="a1">{t('guide_no_casting.tmplayer_does_not_provide_media__a1')}</a></T>
  </MoreHelp>

</main>

<ToTop />

<Footer />
</Base>
