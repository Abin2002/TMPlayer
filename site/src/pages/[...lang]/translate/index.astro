---
// The stored theme, applied before the first paint. With no stored choice nothing is set and the stylesheet follows prefers-color-scheme, which is the system theme.

import Base from '../../../layouts/Base.astro';
import BgArt from '../../../components/BgArt.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ToTop from '../../../components/ToTop.astro';
import T from '../../../components/T.astro';
import Icon from '../../../components/Icon.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { langPaths } from '../../../i18n/paths';
import { text } from '../../../i18n/t';
import { l as link } from '../../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);

const ld0 = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://tmplayer.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Translate",
      "item": "https://tmplayer.org/translate/"
    }
  ]
};

const ld1 = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Help translate TMPlayer",
  "description": "TMPlayer speaks 21 languages, on the website and in the app, machine translated first and corrected by the people who use them. Here is how to fix a word or add a language.",
  "url": "https://tmplayer.org/translate/",
  "inLanguage": "en"
};
---
<Base page="translate" title={t('translate.help_translate_tmplayer_tmplayer')} socialTitle={t('translate.help_translate_tmplayer')} description={t('translate.tmplayer_speaks_21_languages_on')} ogType="article">
  <Fragment slot="head">
    <JsonLd data={ld0} />
    <JsonLd data={ld1} />
  </Fragment>
<!-- Decorative background art, hidden from assistive technology and still under reduced motion. -->
<BgArt />

<Header page="translate" />

<main id="main">

  <section class="page-head">
    <div class="wrap page-head-wrap">
      <p class="crumbs"><T k="translate.translate"><a href={l('/')} slot="a1">{t('translate.translate__a1')}</a><span aria-hidden="true" slot="span1">/</span></T></p>
      <h1><T k="translate.help_tmplayer"><em slot="em1">{t('translate.help_tmplayer__em1')}</em></T></h1>
      <p class="page-lede">{t('translate.besides_english_tmplayer_comes_in')}</p>
      <div class="page-actions">
        <a class="btn btn-filled" href="#fix">{t('translate.fix_a_translation')} <Icon name="arrow-right-sm" /></a>
        <a class="btn btn-outline" href="https://github.com/dracu-lah/TMPlayer/tree/main/site/i18n">{t('translate.the_files_on_github')} <Icon name="arrow-right-sm" /></a>
      </div>
    </div>
  </section>
<Icon name="wave" />
  <section class="band band-tonal" id="languages" aria-labelledby="languages-h">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div class="section-title">
          <h2 id="languages-h">{t('translate.twenty_languages_and_english')}</h2>
          <p class="section-sub">{t('translate.a_language_you_can_read')}</p>
        </div>
      </div>
      <div class="section-body" data-reveal>
        <div class="panel">
          <ul class="lang-list">
            <li><span class="lang-name" lang="es-419">Español</span> <span class="muted">{t('translate.spanish_latin_america')}</span> <code>es-419</code></li>
            <li><span class="lang-name" lang="pt-BR">Português</span> <span class="muted">{t('translate.portuguese_brazil')}</span> <code>pt-BR</code></li>
            <li><span class="lang-name" lang="fr">Français</span> <span class="muted">{t('translate.french')}</span> <code>fr</code></li>
            <li><span class="lang-name" lang="de">Deutsch</span> <span class="muted">{t('translate.german')}</span> <code>de</code></li>
            <li><span class="lang-name" lang="it">Italiano</span> <span class="muted">{t('translate.italian')}</span> <code>it</code></li>
            <li><span class="lang-name" lang="pl">Polski</span> <span class="muted">{t('translate.polish')}</span> <code>pl</code></li>
            <li><span class="lang-name" lang="ru">Русский</span> <span class="muted">{t('translate.russian')}</span> <code>ru</code></li>
            <li><span class="lang-name" lang="uk">Українська</span> <span class="muted">{t('translate.ukrainian')}</span> <code>uk</code></li>
            <li><span class="lang-name" lang="tr">Türkçe</span> <span class="muted">{t('translate.turkish')}</span> <code>tr</code></li>
            <li><span class="lang-name" lang="id">Bahasa Indonesia</span> <span class="muted">{t('translate.indonesian')}</span> <code>id</code></li>
            <li><span class="lang-name" lang="vi">Tiếng Việt</span> <span class="muted">{t('translate.vietnamese')}</span> <code>vi</code></li>
            <li><span class="lang-name" lang="ar">العربية</span> <span class="muted">{t('translate.arabic')}</span> <code>ar</code></li>
            <li><span class="lang-name" lang="fa">فارسی</span> <span class="muted">{t('translate.persian')}</span> <code>fa</code></li>
            <li><span class="lang-name" lang="zh-CN">简体中文</span> <span class="muted">{t('translate.chinese_simplified')}</span> <code>zh-CN</code></li>
            <li><span class="lang-name" lang="zh-TW">繁體中文</span> <span class="muted">{t('translate.chinese_traditional')}</span> <code>zh-TW</code></li>
            <li><span class="lang-name" lang="ja">日本語</span> <span class="muted">{t('translate.japanese')}</span> <code>ja</code></li>
            <li><span class="lang-name" lang="ko">한국어</span> <span class="muted">{t('translate.korean')}</span> <code>ko</code></li>
            <li><span class="lang-name" lang="hi">हिन्दी</span> <span class="muted">{t('translate.hindi')}</span> <code>hi</code></li>
            <li><span class="lang-name" lang="bn">বাংলা</span> <span class="muted">{t('translate.bengali')}</span> <code>bn</code></li>
            <li><span class="lang-name" lang="ml">മലയാളം</span> <span class="muted">{t('translate.malayalam')}</span> <code>ml</code></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
<Icon name="wave-flip" />
  <section class="band" id="fix" aria-labelledby="fix-h">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div class="section-title">
          <h2 id="fix-h">{t('translate.fix_a_word')}</h2>
          <p class="section-sub">{t('translate.three_ways_from_the_quickest')}</p>
        </div>
      </div>
      <div class="section-body" data-reveal>
        <ol class="steps">
          <li id="fix-1">
            <h3>{t('translate.tell_us')}</h3>
            <p><T k="translate.say_which_page_or_screen"><a href="https://t.me/tmplayer_chat" rel="noopener" slot="a1">{t('translate.say_which_page_or_screen__a1')}</a><a href="https://github.com/dracu-lah/TMPlayer/issues" rel="noopener" slot="a2">{t('translate.say_which_page_or_screen__a2')}</a></T></p>
          </li>
          <li id="fix-2">
            <h3>{t('translate.edit_the_file_yourself')}</h3>
            <p><T k="translate.every_language_is_one_json"><a href="https://github.com/dracu-lah/TMPlayer/tree/main/site/i18n" rel="noopener" slot="a1"><code>site/i18n/</code></a><code slot="code1">core/src/commonMain/resources/i18n/</code><code slot="code2">es-419.json</code></T></p>
            <p><T k="translate.english_is_the_source_is"><code slot="code1">en.json</code></T></p>
          </li>
          <li id="fix-3">
            <h3>{t('translate.review_a_whole_language')}</h3>
            <p>{t('translate.read_the_site_or_the')}</p>
          </li>
        </ol>
      </div>
    </div>
  </section>
<Icon name="wave" />
  <section class="band band-tonal" id="rules" aria-labelledby="rules-h">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div class="section-title">
          <h2 id="rules-h">{t('translate.a_few_rules')}</h2>
        </div>
      </div>
      <div class="card-grid card-grid-3" data-reveal>
        <div class="card">
          <h3>{t('translate.keep_the_braces')}</h3>
          <p><T k="translate.words_in_curly_braces_such"><code slot="code1">{'{'}version{'}'}</code><code slot="code2">{'{'}a1{'}'}</code></T></p>
        </div>
        <div class="card">
          <h3>{t('translate.keep_the_names')}</h3>
          <p>{t('translate.tmplayer_telegram_android_tv_fire')}</p>
        </div>
        <div class="card">
          <h3>{t('translate.short_beats_literal')}</h3>
          <p>{t('translate.a_button_that_fits_is')}</p>
        </div>
      </div>
    </div>
  </section>
<Icon name="wave-flip" />
  <section class="band" id="new" aria-labelledby="new-h">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div class="section-title">
          <h2 id="new-h">{t('translate.a_new_language')}</h2>
        </div>
      </div>
      <p class="muted small section-note" data-reveal><T k="translate.naming_the_language_and_saying"><a href="https://github.com/dracu-lah/TMPlayer/issues" rel="noopener" slot="a1">{t('translate.naming_the_language_and_saying__a1')}</a></T></p>
    </div>
  </section>

</main>

<ToTop />

<Footer />
</Base>
