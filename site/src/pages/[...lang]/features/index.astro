---
// The stored theme, applied before the first paint. With no stored choice nothing is set and the stylesheet follows prefers-color-scheme, which is the system theme.

import Base from '../../../layouts/Base.astro';
import BgArt from '../../../components/BgArt.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ToTop from '../../../components/ToTop.astro';
import T from '../../../components/T.astro';
import Icon from '../../../components/Icon.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { langPaths } from '../../../i18n/paths';
import { text } from '../../../i18n/t';
import { l as link } from '../../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);

const ld0 = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://tmplayer.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Features",
      "item": "https://tmplayer.org/features/"
    }
  ]
};
---
<Base page="features" title={t('features.tmplayer_features_stream_telegram_videos')} description={t('features.stream_telegram_videos_while_they')}>
  <Fragment slot="head">
    <JsonLd data={ld0} />
  </Fragment>
<!-- Decorative background art, hidden from assistive technology and still under reduced motion. -->
<BgArt />

<Header page="features" />

<main id="main">

  <section class="page-head">
    <div class="wrap page-head-wrap">
      <p class="crumbs"><T k="features.features"><a href={l('/')} slot="a1">{t('features.features__a1')}</a><span aria-hidden="true" slot="span1">/</span></T></p>
      <h1><T k="features.what_a_telegram_video_player"><em slot="em1">{t('features.what_a_telegram_video_player__em1')}</em></T></h1>
      <p class="page-lede">{t('features.playing_a_file_is_the')}</p>
      <div class="page-actions">
        <a class="btn btn-filled" href={l('/download/')}> <Icon name="download-btn" /> {t('common.download')}</a>
        <a class="btn btn-outline" href={l('/install/')}>{t('features.how_to_install')} <Icon name="arrow-right-sm" /></a>
      </div>
      <nav class="platform-jump" aria-label={t('features.on_this_page')}>
        <a href="#does">{t('home.what_it_does')}</a>
        <a href="#screens">{t('features.what_it_looks_like')}</a>
        <a href="#tour">{t('features.a_closer_look')}</a>
        <a href="#desktop">{t('features.jump_windows_and_linux')}</a>
        <a href="#keys">{t('features.jump_keyboard_shortcuts')}</a>
      </nav>
    </div>
  </section>

<Icon name="wave" />

  <section class="band band-tonal" id="does" aria-labelledby="does-h">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div class="section-title">
          <h2 id="does-h">{t('home.what_it_does')}</h2>
          <p class="section-sub">{t('features.built_for_a_remote_a')}</p>
        </div>
      </div>

      <div class="two-col" data-reveal>
        <div class="panel">
          <h3> <span class="panel-icon icon-play" aria-hidden="true">
              <Icon name="play-card" />
            </span> {t('features.watching')}</h3>
          <ul class="ticks">
            <li><T k="features.skipping_ahead_re_aims_the"><strong slot="strong1">{t('features.skipping_ahead_re_aims_the__strong1')}</strong></T></li>
            <li><T k="features.mkv_mp4_avi_and_ts"><strong slot="strong1">{t('features.mkv_mp4_avi_and_ts__strong1')}</strong></T></li>
            <li><T k="features.with_a_continue_watching_row"><strong slot="strong1">{t('features.with_a_continue_watching_row__strong1')}</strong></T></li>
            <li><T k="features.the_previous_one_is_cleared"><strong slot="strong1">{t('features.the_previous_one_is_cleared__strong1')}</strong></T></li>
            <li><T k="features.downloads_you_choose"><strong slot="strong1">{t('features.downloads_you_choose__strong1')}</strong></T></li>
            <li><T k="features.skips_intros_and_credits"><strong slot="strong1">{t('features.skips_intros_and_credits__strong1')}</strong></T></li>
            <li><T k="features.bookmarks_and_a_b_repeat"><strong slot="strong1">{t('features.bookmarks_and_a_b_repeat__strong1')}</strong></T></li>
            <li><T k="features.subtitles_found_online"><strong slot="strong1">{t('features.subtitles_found_online__strong1')}</strong></T></li>
            <li><T k="features.the_same_library_drawn_for"><strong slot="strong1">{t('features.the_same_library_drawn_for__strong1')}</strong></T></li>
          </ul>
        </div>
        <div class="panel">
          <h3> <span class="panel-icon icon-browse" aria-hidden="true">
              <Icon name="search-panel" />
            </span> {t('features.browsing')}</h3>
          <ul class="ticks">
            <li><T k="features.chats_filter_down_to_playable"><strong slot="strong1">{t('features.chats_filter_down_to_playable__strong1')}</strong></T></li>
            <li><T k="features.home_and_series_pages"><strong slot="strong1">{t('features.home_and_series_pages__strong1')}</strong></T></li>
            <li><T k="features.topics_tabs_one_tile"><strong slot="strong1">{t('features.topics_tabs_one_tile__strong1')}</strong></T></li>
            <li><T k="features.watch_later_new_episodes"><strong slot="strong1">{t('features.watch_later_new_episodes__strong1')}</strong></T></li>
            <li><T k="features.tv_home_channels"><strong slot="strong1">{t('features.tv_home_channels__strong1')}</strong></T></li>
            <li><T k="features.posters_and_overviews"><strong slot="strong1">{t('features.posters_and_overviews__strong1')}</strong></T></li>
            <li><T k="features.the_next_one_starts_after"><strong slot="strong1">{t('features.the_next_one_starts_after__strong1')}</strong></T></li>
            <li><T k="features.typos_missing_accents_and_one"><strong slot="strong1">{t('features.typos_missing_accents_and_one__strong1')}</strong></T></li>
            <li><T k="features.with_your_remote_s_microphone"><strong slot="strong1">{t('features.with_your_remote_s_microphone__strong1')}</strong></T></li>
            <li><T k="features.pin_kids_lock_backup"><strong slot="strong1">{t('features.pin_kids_lock_backup__strong1')}</strong></T></li>
            <li><T k="features.from_github_on_android_windows"><strong slot="strong1">{t('features.from_github_on_android_windows__strong1')}</strong></T></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

<Icon name="wave-flip" />

  <section class="band" id="screens" aria-labelledby="shots-h">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div class="section-title">
          <h2 id="shots-h">{t('features.what_it_looks_like')}</h2>
          <p class="section-sub">{t('features.four_screens_in_the_order')}</p>
          <p class="section-sub"><T k="features.demo_artwork_photos_from_unsplash"><a href="https://github.com/dracu-lah/TMPlayer/blob/main/docs/promo-art/CREDITS.md" rel="noopener" slot="a1">{t('features.demo_artwork_photos_from_unsplash__a1')}</a></T></p>
        </div>
      </div>

      <div class="shots">
        <figure class="shot" data-reveal>
          <div class="device device-phone">
            <div class="screen">
              <!-- The source carries the light file and the img carries the dark one, so a browser
                   downloads exactly one of the two; app.js rewrites the source's media attribute
                   when the reader presses the toggle. -->
              <picture>
                <source data-theme-src srcset="/screenshots/phone-chats-light.webp" media="(prefers-color-scheme: light)">
                <img src="/screenshots/phone-chats.webp" alt={t('features.tmplayer_on_a_phone_listing')} width="1080" height="2400" loading="lazy" decoding="async">
              </picture>
            </div>
          </div>
          <figcaption><T k="features.every_chat_and_channel_you"><b slot="b1">{t('features.every_chat_and_channel_you__b1')}</b></T></figcaption>
        </figure>

        <figure class="shot" data-reveal>
          <div class="device device-phone">
            <div class="screen">
              <picture>
                <source data-theme-src srcset="/screenshots/phone-grid-light.webp" media="(prefers-color-scheme: light)">
                <img src="/screenshots/phone-grid.webp" alt={t('features.a_dense_grid_of_demo')} width="1080" height="2400" loading="lazy" decoding="async">
              </picture>
            </div>
          </div>
          <figcaption><T k="features.posters_with_the_year_size"><b slot="b1">{t('features.posters_with_the_year_size__b1')}</b></T></figcaption>
        </figure>

        <figure class="shot" data-reveal>
          <div class="device device-tv">
            <div class="screen">
              <picture>
                <source data-theme-src srcset="/screenshots/tv-chats-light.webp" media="(prefers-color-scheme: light)">
                <img src="/screenshots/tv-chats.webp" alt={t('features.the_same_chat_list_on')} width="1920" height="1080" loading="lazy" decoding="async">
              </picture>
            </div>
            <div class="stand"></div>
            <div class="foot"></div>
          </div>
          <figcaption><T k="features.a_rail_for_the_remote"><b slot="b1">{t('features.a_rail_for_the_remote__b1')}</b></T></figcaption>
        </figure>

        <figure class="shot" data-reveal>
          <div class="device device-tv">
            <div class="screen">
              <picture>
                <source data-theme-src srcset="/screenshots/tv-home-light.webp" media="(prefers-color-scheme: light)">
                <img src="/screenshots/tv-home.webp" alt={t('features.tv_home_rows_alt')} width="1920" height="1080" loading="lazy" decoding="async">
              </picture>
            </div>
            <div class="stand"></div>
            <div class="foot"></div>
          </div>
          <figcaption><T k="features.home_rows_caption"><b slot="b1">{t('features.home_rows_caption__b1')}</b></T></figcaption>
        </figure>

        <figure class="shot" data-reveal>
          <div class="device device-tv">
            <div class="screen">
              <picture>
                <source data-theme-src srcset="/screenshots/tv-settings-light.webp" media="(prefers-color-scheme: light)">
                <img src="/screenshots/tv-settings.webp" alt={t('features.tmplayer_settings_on_a_television')} width="1920" height="1080" loading="lazy" decoding="async">
              </picture>
            </div>
            <div class="stand"></div>
            <div class="foot"></div>
          </div>
          <figcaption><T k="features.hide_small_clips_autoplay_the"><b slot="b1">{t('features.hide_small_clips_autoplay_the__b1')}</b></T></figcaption>
        </figure>

        <figure class="shot" data-reveal>
          <div class="device device-tv device-desktop">
            <div class="screen">
              <picture>
                <source data-theme-src srcset="/screenshots/desktop-grid-light.webp" media="(prefers-color-scheme: light)">
                <img src="/screenshots/desktop-grid.webp" alt={t('features.the_tmplayer_desktop_app_on')} width="1920" height="1200" loading="lazy" decoding="async">
              </picture>
            </div>
            <div class="stand"></div>
            <div class="foot"></div>
          </div>
          <figcaption><T k="features.a_sidebar_and_a_grid"><b slot="b1">{t('features.a_sidebar_and_a_grid__b1')}</b></T></figcaption>
        </figure>

        <figure class="shot" data-reveal>
          <div class="device device-tv device-desktop">
            <div class="screen">
              <img src="/screenshots/desktop-player.webp" alt={t('features.the_tmplayer_desktop_player_over')} width="1920" height="1200" loading="lazy" decoding="async">
            </div>
            <div class="stand"></div>
            <div class="foot"></div>
          </div>
          <figcaption><T k="features.played_through_mpv_with_the"><b slot="b1">{t('features.played_through_mpv_with_the__b1')}</b></T></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- A closer look: the same demo screenshots, with numbered marks laid over them in CSS so the
       marks stay sharp and the notes stay translatable. Each mark's --x and --y are percentages
       of the screenshot itself, measured on the 1920 wide file, so they hold at any size. -->
  <section class="band" id="tour" aria-labelledby="tour-h">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div class="section-title">
          <h2 id="tour-h">{t('features.a_closer_look')}</h2>
          <p class="section-sub">{t('features.five_screens_with_their_parts')}</p>
        </div>
      </div>

      <div class="shots tour">
        <figure class="shot tour-shot" id="tour-player" data-reveal>
          <div class="device device-tv device-desktop">
            <div class="screen">
              <img src="/screenshots/desktop-player.webp" alt={t('features.the_tmplayer_desktop_player_over')} width="1920" height="1200" loading="lazy" decoding="async">
              <div class="tour-marks" aria-hidden="true">
                <span style="--x: 60%; --y: 90.2%"></span>
                <span style="--x: 7%; --y: 95.2%"></span>
                <span style="--x: 93.2%; --y: 95.2%"></span>
              </div>
            </div>
            <div class="stand"></div>
            <div class="foot"></div>
          </div>
          <figcaption>
            <h3>{t('features.the_player_watching_while_it')}</h3>
            <p>{t('features.a_video_starts_while_it')}</p>
            <ol class="tour-list">
              <li>{t('features.the_lighter_part_of_the')}</li>
              <li>{t('features.subtitles_audio_track_speed_and')}</li>
              <li>{t('features.volume_the_mini_player_in')}</li>
            </ol>
          </figcaption>
        </figure>

        <figure class="shot tour-shot" id="tour-library" data-reveal>
          <div class="device device-tv device-desktop">
            <div class="screen">
              <picture>
                <source data-theme-src srcset="/screenshots/desktop-grid-light.webp" media="(prefers-color-scheme: light)">
                <img src="/screenshots/desktop-grid.webp" alt={t('features.the_tmplayer_desktop_app_on')} width="1920" height="1200" loading="lazy" decoding="async">
              </picture>
              <div class="tour-marks" aria-hidden="true">
                <span style="--x: 13%; --y: 27%"></span>
                <span style="--x: 13%; --y: 47.3%"></span>
                <span style="--x: 33.5%; --y: 53.2%"></span>
                <span style="--x: 80%; --y: 5.9%"></span>
              </div>
            </div>
            <div class="stand"></div>
            <div class="foot"></div>
          </div>
          <figcaption>
            <h3>{t('features.browsing_a_chat_on_windows')}</h3>
            <p>{t('features.every_video_in_a_chat')}</p>
            <ol class="tour-list">
              <li>{t('features.home_history_favourites_and_downloads')}</li>
              <li>{t('features.your_chats_split_the_way')}</li>
              <li>{t('features.each_poster_gives_the_running')}</li>
              <li>{t('features.search_inside_the_chat_you')}</li>
            </ol>
          </figcaption>
        </figure>

        <figure class="shot tour-shot" id="tour-tv" data-reveal>
          <div class="device device-tv">
            <div class="screen">
              <picture>
                <source data-theme-src srcset="/screenshots/tv-chats-light.webp" media="(prefers-color-scheme: light)">
                <img src="/screenshots/tv-chats.webp" alt={t('features.the_same_chat_list_on')} width="1920" height="1080" loading="lazy" decoding="async">
              </picture>
              <div class="tour-marks" aria-hidden="true">
                <span style="--x: 17%; --y: 27.8%"></span>
                <span style="--x: 38.3%; --y: 34%"></span>
                <span style="--x: 93.8%; --y: 17.5%"></span>
                <span style="--x: 37%; --y: 63%"></span>
              </div>
            </div>
            <div class="stand"></div>
            <div class="foot"></div>
          </div>
          <figcaption>
            <h3>{t('features.made_for_a_remote_on')}</h3>
            <p>{t('features.big_cards_you_can_read')}</p>
            <ol class="tour-list">
              <li>{t('features.a_rail_down_the_left')}</li>
              <li>{t('features.sort_a_to_z_or')}</li>
              <li>{t('features.search_by_voice_with_your')}</li>
              <li>{t('features.hold_ok_on_a_chat')}</li>
            </ol>
          </figcaption>
        </figure>

        <figure class="shot tour-shot" id="tour-tv-home" data-reveal>
          <!-- The launcher's row only, cropped by scripts/annotate-shot.py (tv-home-screen.json). The
               launcher has no light theme, so one picture serves both. -->
          <div class="frame">
            <div class="screen">
              <img src="/screenshots/tv-home-screen.webp" alt={t('features.tv_home_screen_alt')} width="1440" height="420" loading="lazy" decoding="async">
              <div class="tour-marks" aria-hidden="true">
                <span style="--x: 27%; --y: 11.6%"></span>
                <span style="--x: 24%; --y: 73.8%"></span>
                <span style="--x: 82.4%; --y: 19.1%"></span>
              </div>
            </div>
          </div>
          <figcaption>
            <h3>{t('features.tour_tv_home_title')}</h3>
            <p>{t('features.tour_tv_home_text')}</p>
            <ol class="tour-list">
              <li>{t('features.tour_tv_home_row')}</li>
              <li>{t('features.tour_tv_home_card')}</li>
              <li>{t('features.tour_tv_home_posters')}</li>
            </ol>
          </figcaption>
        </figure>

        <figure class="shot tour-shot" id="tour-settings" data-reveal>
          <div class="device device-tv">
            <div class="screen">
              <picture>
                <source data-theme-src srcset="/screenshots/tv-settings-light.webp" media="(prefers-color-scheme: light)">
                <img src="/screenshots/tv-settings.webp" alt={t('features.tmplayer_settings_on_a_television')} width="1920" height="1080" loading="lazy" decoding="async">
              </picture>
              <div class="tour-marks" aria-hidden="true">
                <span style="--x: 51%; --y: 40.8%"></span>
                <span style="--x: 33%; --y: 54.9%"></span>
                <span style="--x: 45%; --y: 69%"></span>
                <span style="--x: 40%; --y: 80.5%"></span>
              </div>
            </div>
            <div class="stand"></div>
            <div class="foot"></div>
          </div>
          <figcaption>
            <h3>{t('features.settings_a_few_short_pages')}</h3>
            <p>{t('features.changes_save_as_you_make')}</p>
            <ol class="tour-list">
              <li>{t('features.autoplay_of_the_next_episode')}</li>
              <li>{t('features.subtitle_size_a_box_behind')}</li>
              <li>{t('features.which_videos_show_such_as')}</li>
              <li>{t('features.how_much_space_is_free')}</li>
            </ol>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

<Icon name="wave" />

  <section class="band band-tonal" id="desktop" aria-labelledby="desktop-h">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div class="section-title">
          <h2 id="desktop-h">{t('features.on_windows_and_linux')}</h2>
          <p class="section-sub">{t('features.the_same_account_library_and')}</p>
        </div>
      </div>

      <div class="two-col" data-reveal>
        <div class="panel">
          <h3> <span class="panel-icon icon-browse" aria-hidden="true">
              <Icon name="monitor-panel" />
            </span> {t('features.the_window')}</h3>
          <ul class="ticks">
            <li><T k="features.or_with_a_phone_number"><strong slot="strong1">{t('features.or_with_a_phone_number__strong1')}</strong></T></li>
            <li><T k="features.home_history_favourites_downloads_sidebar"><strong slot="strong1">{t('features.home_history_favourites_downloads_sidebar__strong1')}</strong></T></li>
            <li><T k="features.to_play_restart_download_or"><strong slot="strong1">{t('features.to_play_restart_download_or__strong1')}</strong></T></li>
            <li><T k="features.your_downloads_folder_unless_you"><strong slot="strong1">{t('features.your_downloads_folder_unless_you__strong1')}</strong></T></li>
            <li><T k="features.size_and_position_a_second"><strong slot="strong1">{t('features.size_and_position_a_second__strong1')}</strong></T></li>
          </ul>
        </div>
        <div class="panel">
          <h3> <span class="panel-icon icon-play" aria-hidden="true">
              <Icon name="play-card" />
            </span> {t('features.the_player')}</h3>
          <ul class="ticks">
            <li><T k="features.mkv_mp4_avi_ts_image"><strong slot="strong1">{t('features.mkv_mp4_avi_ts_image__strong1')}</strong></T></li>
            <li><T k="features.and_seeks_without_waiting"><strong slot="strong1">{t('features.and_seeks_without_waiting__strong1')}</strong></T></li>
            <li><T k="features.offers_the_next_episode_and"><strong slot="strong1">{t('features.offers_the_next_episode_and__strong1')}</strong></T></li>
            <li><T k="features.while_a_video_plays"><strong slot="strong1">{t('features.while_a_video_plays__strong1')}</strong></T></li>
            <li><T k="features.the_linux_desktop_s_media"><strong slot="strong1">{t('features.the_linux_desktop_s_media__strong1')}</strong></T></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

<Icon name="wave-flip" />

  <section class="band" id="keys" aria-labelledby="keys-h">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div class="section-title">
          <h2 id="keys-h">{t('features.desktop_keyboard_shortcuts')}</h2>
          <p class="section-sub">{t('features.youtube_s_keys_plus_the')}</p>
        </div>
      </div>

      <div class="keys-wrap" data-reveal>
        <table class="keys">
          <thead>
            <tr><th scope="col">{t('features.to_do_this')}</th><th scope="col">{t('features.press')}</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">{t('features.play_or_pause')}</th><td><kbd>Space</kbd> <kbd>K</kbd>{t('features.or_click_the_picture')}</td></tr>
            <tr><th scope="row">{t('features.back_or_forward_5_seconds')}</th><td><kbd>&larr;</kbd> <kbd>&rarr;</kbd></td></tr>
            <tr><th scope="row">{t('features.back_or_forward_10_seconds')}</th><td><kbd>J</kbd> <kbd>L</kbd><T k="features.or_with_the_wheel"><kbd slot="kbd3">Shift</kbd></T></td></tr>
            <tr><th scope="row">{t('features.back_or_forward_a_minute')}</th><td><kbd>Shift</kbd>+<kbd>&larr;</kbd> <kbd>Shift</kbd>+<kbd>&rarr;</kbd></td></tr>
            <tr><th scope="row">{t('features.back_or_forward_5_minutes')}</th><td><kbd>Ctrl</kbd>+<kbd>Alt</kbd>+<kbd>&larr;</kbd> <kbd>Ctrl</kbd>+<kbd>Alt</kbd>+<kbd>&rarr;</kbd></td></tr>
            <tr><th scope="row">{t('features.one_frame_back_or_forward')}</th><td><kbd>,</kbd> <kbd>.</kbd></td></tr>
            <tr><th scope="row">{t('features.jump_to_a_tenth_of')}</th><td><kbd>0</kbd> <T k="features.to"><kbd slot="kbd2">9</kbd></T> <kbd>Home</kbd> <kbd>End</kbd></td></tr>
            <tr><th scope="row">{t('features.volume')}</th><td><kbd>&uarr;</kbd> <kbd>&darr;</kbd>{t('features.or_the_wheel')}</td></tr>
            <tr><th scope="row">{t('features.mute')}</th><td><kbd>M</kbd></td></tr>
            <tr><th scope="row">{t('features.fullscreen')}</th><td><kbd>F</kbd> <kbd>F11</kbd> <kbd>Alt</kbd><T k="features.or_double_click_leaves_it"><kbd slot="kbd4">Enter</kbd><kbd slot="kbd5">Esc</kbd></T></td></tr>
            <tr><th scope="row">{t('features.next_or_previous_subtitles_on')}</th><td><kbd>S</kbd> <kbd>Shift</kbd>+<kbd>S</kbd> <kbd>C</kbd></td></tr>
            <tr><th scope="row">{t('features.next_or_previous_audio_track')}</th><td><kbd>A</kbd> <kbd>Shift</kbd>+<kbd>A</kbd></td></tr>
            <tr><th scope="row">{t('features.faster_slower_normal_speed')}</th><td><kbd>]</kbd> <kbd>[</kbd> <kbd>Backspace</kbd></td></tr>
            <tr><th scope="row">{t('features.next_or_previous_episode')}</th><td><kbd>Shift</kbd>+<kbd>N</kbd> <kbd>Shift</kbd>+<kbd>P</kbd>, <kbd>Page Down</kbd> <kbd>Page Up</kbd></td></tr>
            <tr><th scope="row">{t('features.always_on_top')}</th><td><kbd>Ctrl</kbd>+<kbd>T</kbd></td></tr>
            <tr><th scope="row">{t('features.mini_player_in_the_corner')}</th><td><kbd>Ctrl</kbd>+<kbd>P</kbd></td></tr>
            <tr><th scope="row">{t('features.every_shortcut')}</th><td><kbd>?</kbd></td></tr>
            <tr><th scope="row">{t('features.playback_details')}</th><td><kbd>I</kbd></td></tr>
            <tr><th scope="row">{t('features.back_to_the_grid')}</th><td><kbd>Esc</kbd> <kbd>Backspace</kbd>{t('features.or_the_mouse_s_back')}</td></tr>
            <tr><th scope="row">{t('features.quit')}</th><td><kbd>Ctrl</kbd>+<kbd>Q</kbd></td></tr>
          </tbody>
        </table>
      </div>
      <p class="muted small section-note" data-reveal><T k="features.right_click_the_picture_for"><kbd slot="kbd1">/</kbd><kbd slot="kbd2">Ctrl</kbd><kbd slot="kbd3">F</kbd><kbd slot="kbd4">Ctrl</kbd><kbd slot="kbd5">,</kbd></T></p>
    </div>
  </section>

