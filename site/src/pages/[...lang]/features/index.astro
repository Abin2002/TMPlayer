---
// The features page. Base applies the stored theme before the first paint; with no stored choice
// nothing is set and the stylesheet follows prefers-color-scheme, which is the system theme.

import Base from '../../../layouts/Base.astro';
import BgArt from '../../../components/BgArt.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ToTop from '../../../components/ToTop.astro';
import T from '../../../components/T.astro';
import Icon from '../../../components/Icon.astro';
import PageHead from '../../../components/PageHead.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { breadcrumb } from '../../../components/breadcrumb';
import Band from '../../../components/Band.astro';
import Cards from '../../../components/Cards.astro';
import TickPanel from '../../../components/features/TickPanel.astro';
import GalleryShot from '../../../components/features/GalleryShot.astro';
import TourShot from '../../../components/features/TourShot.astro';
import StarCard from '../../../components/StarCard.astro';
import LinkCard from '../../../components/LinkCard.astro';
import type { Screen } from '../../../components/features/GalleryShot.astro';
import type { Point } from '../../../components/features/TourShot.astro';
import { langPaths } from '../../../i18n/paths';
import { text } from '../../../i18n/t';
import { l as link } from '../../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);


// What it does: two panels each, for the apps and for the desktop.
const watching = [
  'features.skipping_ahead_re_aims_the', 'features.mkv_mp4_avi_and_ts',
  'features.with_a_continue_watching_row', 'features.only_the_video_playing_is_kept',
  'features.downloads_you_choose', 'features.skips_intros_and_credits',
  'features.bookmarks_and_a_b_repeat', 'features.subtitles_found_online',
  'features.the_same_library_drawn_for',
];
const browsing = [
  'features.chats_filter_down_to_playable', 'features.home_and_series_pages',
  'features.topics_tabs_one_tile', 'features.watch_later_new_episodes',
  'features.tv_home_channels', 'features.posters_and_overviews',
  'features.the_next_one_starts_after', 'features.typos_missing_accents_and_one',
  'features.with_your_remote_s_microphone', 'features.pin_kids_lock_backup',
  'features.from_github_on_android_windows',
];
const desktopWindow = [
  'features.or_with_a_phone_number', 'features.home_history_favourites_downloads_sidebar',
  'features.to_play_restart_download_or', 'features.your_downloads_folder_unless_you',
  'features.size_and_position_a_second',
];
const desktopPlayer = [
  'features.mkv_mp4_avi_ts_image', 'features.and_seeks_without_waiting',
  'features.offers_the_next_episode_and', 'features.while_a_video_plays',
  'features.the_linux_desktop_s_media',
];

// The demo screenshots. Every one but the desktop player and the launcher row is a light/dark pair.
const shots = {
  phoneChats: { device: 'phone', src: '/screenshots/phone-chats.webp', light: '/screenshots/phone-chats-light.webp', alt: 'features.tmplayer_on_a_phone_listing', width: 1080, height: 2400 },
  phoneGrid: { device: 'phone', src: '/screenshots/phone-grid.webp', light: '/screenshots/phone-grid-light.webp', alt: 'features.a_dense_grid_of_demo', width: 1080, height: 2400 },
  tvChats: { device: 'tv', src: '/screenshots/tv-chats.webp', light: '/screenshots/tv-chats-light.webp', alt: 'features.the_same_chat_list_on', width: 1920, height: 1080 },
  tvHome: { device: 'tv', src: '/screenshots/tv-home.webp', light: '/screenshots/tv-home-light.webp', alt: 'features.tv_home_rows_alt', width: 1920, height: 1080 },
  tvSettings: { device: 'tv', src: '/screenshots/tv-settings.webp', light: '/screenshots/tv-settings-light.webp', alt: 'features.tmplayer_settings_on_a_television', width: 1920, height: 1080 },
  desktopGrid: { device: 'desktop', src: '/screenshots/desktop-grid.webp', light: '/screenshots/desktop-grid-light.webp', alt: 'features.the_tmplayer_desktop_app_on', width: 1920, height: 1200 },
  desktopPlayer: { device: 'desktop', src: '/screenshots/desktop-player.webp', alt: 'features.the_tmplayer_desktop_player_over', width: 1920, height: 1200 },
  // The launcher's row only, cropped by scripts/annotate-shot.py (tv-home-screen.json). The
  // launcher has no light theme, so one picture serves both.
  tvLauncher: { device: 'frame', src: '/screenshots/tv-home-screen.webp', alt: 'features.tv_home_screen_alt', width: 1440, height: 420 },
} satisfies Record<string, Screen>;

// What it looks like: each shot with its caption key.
const gallery: [Screen, string][] = [
  [shots.phoneChats, 'features.every_chat_and_channel_you'],
  [shots.phoneGrid, 'features.posters_with_the_year_size'],
  [shots.tvChats, 'features.a_rail_for_the_remote'],
  [shots.tvHome, 'features.home_rows_caption'],
  [shots.tvSettings, 'features.hide_small_clips_autoplay_the'],
  [shots.desktopGrid, 'features.a_sidebar_and_a_grid'],
  [shots.desktopPlayer, 'features.played_through_mpv_with_the'],
];

// A closer look: the same demo screenshots, with numbered marks laid over them in CSS so the
// marks stay sharp and the notes stay translatable. Each mark's --x and --y are percentages of
// the screenshot itself, measured on the 1920 wide file, so they hold at any size. Point N is
// mark N and line N of the list.
const tour: { id: string; shot: Screen; title: string; lede: string; points: Point[] }[] = [
  {
    id: 'tour-player', shot: shots.desktopPlayer,
    title: 'features.the_player_watching_while_it', lede: 'features.a_video_starts_while_it',
    points: [
      { x: '60%', y: '90.2%', note: 'features.the_lighter_part_of_the' },
      { x: '7%', y: '95.2%', note: 'features.subtitles_audio_track_speed_and' },
      { x: '93.2%', y: '95.2%', note: 'features.volume_the_mini_player_in' },
    ],
  },
  {
    id: 'tour-library', shot: shots.desktopGrid,
    title: 'features.browsing_a_chat_on_windows', lede: 'features.every_video_in_a_chat',
    points: [
      { x: '13%', y: '27%', note: 'features.home_history_favourites_and_downloads' },
      { x: '13%', y: '47.3%', note: 'features.your_chats_split_the_way' },
      { x: '33.5%', y: '53.2%', note: 'features.each_poster_gives_the_running' },
      { x: '80%', y: '5.9%', note: 'features.search_inside_the_chat_you' },
    ],
  },
  {
    id: 'tour-tv', shot: shots.tvChats,
    title: 'features.made_for_a_remote_on', lede: 'features.big_cards_you_can_read',
    points: [
      { x: '17%', y: '27.8%', note: 'features.a_rail_down_the_left' },
      { x: '38.3%', y: '34%', note: 'features.sort_a_to_z_or' },
      { x: '93.8%', y: '17.5%', note: 'features.search_by_voice_with_your' },
      { x: '37%', y: '63%', note: 'features.hold_ok_on_a_chat' },
    ],
  },
  {
    id: 'tour-tv-home', shot: shots.tvLauncher,
    title: 'features.tour_tv_home_title', lede: 'features.tour_tv_home_text',
    points: [
      { x: '27%', y: '11.6%', note: 'features.tour_tv_home_row' },
      { x: '24%', y: '73.8%', note: 'features.tour_tv_home_card' },
      { x: '82.4%', y: '19.1%', note: 'features.tour_tv_home_posters' },
    ],
  },
  {
    id: 'tour-settings', shot: shots.tvSettings,
    title: 'features.settings_a_few_short_pages', lede: 'features.changes_save_as_you_make',
    points: [
      { x: '51%', y: '56.3%', note: 'features.autoplay_of_the_next_episode' },
      { x: '33%', y: '70.5%', note: 'features.subtitle_size_a_box_behind' },
      { x: '45%', y: '84.5%', note: 'features.which_videos_show_such_as' },
    ],
  },
];

const next = [
  { href: '/download/', title: 'common.download', body: 'features.the_latest_release_and_its', go: 'home.get_it' },
  { href: '/install/', title: 'features.how_to_install', body: 'features.steps_for_tv_phone_windows', go: 'features.read_the_steps' },
  { href: '/android-tv/', title: 'home.on_android_tv', body: 'features.the_ten_foot_layout_and', go: 'features.for_the_television' },
];
---
<Base page="features" title={t('features.tmplayer_features_stream_telegram_videos')} description={t('features.stream_telegram_videos_while_they')}>
  <Fragment slot="head">
    <JsonLd data={breadcrumb(['Features', '/features/'])} />
  </Fragment>
{/* Decorative background art, hidden from assistive technology and still under reduced motion. */}
<BgArt />

<Header page="features" />

<main id="main">

  <PageHead lede={t('features.playing_a_file_is_the')}>
    <Fragment slot="crumbs"><T k="features.features"><a href={l('/')} slot="a1">{t('features.features__a1')}</a><span aria-hidden="true" slot="span1">/</span></T></Fragment>
    <Fragment slot="title"><T k="features.what_a_telegram_video_player"><em slot="em1">{t('features.what_a_telegram_video_player__em1')}</em></T></Fragment>
    <Fragment slot="actions">
      <a class="btn btn-filled" href={l('/download/')}> <Icon name="download-btn" /> {t('common.download')}</a>
      <a class="btn btn-outline" href={l('/install/')}>{t('features.how_to_install')} <Icon name="arrow-right-sm" /></a>
    </Fragment>
    <nav class="platform-jump" aria-label={t('features.on_this_page')}>
      <a href="#does">{t('home.what_it_does')}</a>
      <a href="#screens">{t('features.what_it_looks_like')}</a>
      <a href="#tour">{t('features.a_closer_look')}</a>
      <a href="#desktop">{t('features.jump_windows_and_linux')}</a>
      <a href="#keys">{t('features.jump_keyboard_shortcuts')}</a>
    </nav>
  </PageHead>

  <Band wave id="does" title={t('home.what_it_does')} sub={t('features.built_for_a_remote_a')} tonal>
    <div class="two-col" data-reveal>
      <TickPanel icon="play-card" tone="play" title="features.watching" items={watching} />
      <TickPanel icon="search-panel" tone="browse" title="features.browsing" items={browsing} />
    </div>
  </Band>

  <Band wave id="screens" labelledby="shots-h" title={t('features.what_it_looks_like')} sub={t('features.four_screens_in_the_order')}>
    <p slot="head" class="section-sub"><T k="features.demo_artwork_photos_from_unsplash"><a href="https://github.com/dracu-lah/TMPlayer/blob/main/docs/promo-art/CREDITS.md" rel="noopener" slot="a1">{t('features.demo_artwork_photos_from_unsplash__a1')}</a></T></p>
    <div class="shots">
      {gallery.map(([shot, caption]) => <GalleryShot shot={shot} caption={caption} />)}
    </div>
  </Band>

  <Band id="tour" title={t('features.a_closer_look')} sub={t('features.five_screens_with_their_parts')}>
    <div class="shots tour">
      {tour.map((s) => <TourShot {...s} />)}
    </div>
  </Band>

  <Band wave id="desktop" title={t('features.on_windows_and_linux')} sub={t('features.the_same_account_library_and')} tonal>
    <div class="two-col" data-reveal>
      <TickPanel icon="monitor-panel" tone="browse" title="features.the_window" items={desktopWindow} />
      <TickPanel icon="play-card" tone="play" title="features.the_player" items={desktopPlayer} />
    </div>
    <p class="muted small section-note" data-reveal><T k="desktop.features_link"><a href={l('/desktop/')} slot="a1">{t('desktop.features_link__a1')}</a></T></p>
  </Band>

  <Band wave id="keys" title={t('features.desktop_keyboard_shortcuts')} sub={t('features.youtube_s_keys_plus_the')}>
    <div class="keys-wrap" data-reveal>
      <table class="keys">
        <thead>
          <tr><th scope="col">{t('features.to_do_this')}</th><th scope="col">{t('features.press')}</th></tr>
        </thead>
        <tbody>
          <tr><th scope="row">{t('features.play_or_pause')}</th><td><kbd>Space</kbd> <kbd>K</kbd>{t('features.or_click_the_picture')}</td></tr>
          <tr><th scope="row">{t('features.back_or_forward_5_seconds')}</th><td><kbd>&larr;</kbd> <kbd>&rarr;</kbd></td></tr>
          <tr><th scope="row">{t('features.back_or_forward_10_seconds')}</th><td><kbd>J</kbd> <kbd>L</kbd><T k="features.or_with_the_wheel"><kbd slot="kbd3">Shift</kbd></T></td></tr>
          <tr><th scope="row">{t('features.back_or_forward_a_minute')}</th><td><kbd>Shift</kbd>+<kbd>&larr;</kbd> <kbd>Shift</kbd>+<kbd>&rarr;</kbd></td></tr>
          <tr><th scope="row">{t('features.back_or_forward_5_minutes')}</th><td><kbd>Ctrl</kbd>+<kbd>Alt</kbd>+<kbd>&larr;</kbd> <kbd>Ctrl</kbd>+<kbd>Alt</kbd>+<kbd>&rarr;</kbd></td></tr>
          <tr><th scope="row">{t('features.one_frame_back_or_forward')}</th><td><kbd>,</kbd> <kbd>.</kbd></td></tr>
          <tr><th scope="row">{t('features.jump_to_a_tenth_of')}</th><td><kbd>0</kbd> <T k="features.to"><kbd slot="kbd2">9</kbd></T> <kbd>Home</kbd> <kbd>End</kbd></td></tr>
          <tr><th scope="row">{t('features.volume')}</th><td><kbd>&uarr;</kbd> <kbd>&darr;</kbd>{t('features.or_the_wheel')}</td></tr>
          <tr><th scope="row">{t('features.mute')}</th><td><kbd>M</kbd></td></tr>
          <tr><th scope="row">{t('features.fullscreen')}</th><td><kbd>F</kbd> <kbd>F11</kbd> <kbd>Alt</kbd><T k="features.or_double_click_leaves_it"><kbd slot="kbd4">Enter</kbd><kbd slot="kbd5">Esc</kbd></T></td></tr>
          <tr><th scope="row">{t('features.next_or_previous_subtitles_on')}</th><td><kbd>V</kbd> <kbd>Shift</kbd>+<kbd>V</kbd> <kbd>C</kbd></td></tr>
          <tr><th scope="row">{t('features.next_or_previous_audio_track')}</th><td><kbd>A</kbd> <kbd>Shift</kbd>+<kbd>A</kbd></td></tr>
          <tr><th scope="row">{t('features.faster_slower_normal_speed')}</th><td><kbd>]</kbd> <kbd>[</kbd> <kbd>Backspace</kbd></td></tr>
          <tr><th scope="row">{t('features.next_or_previous_episode')}</th><td><kbd>Shift</kbd>+<kbd>N</kbd> <kbd>Shift</kbd>+<kbd>P</kbd>, <kbd>Page Down</kbd> <kbd>Page Up</kbd></td></tr>
          <tr><th scope="row">{t('features.always_on_top')}</th><td><kbd>Ctrl</kbd>+<kbd>T</kbd></td></tr>
          <tr><th scope="row">{t('features.mini_player_in_the_corner')}</th><td><kbd>Ctrl</kbd>+<kbd>P</kbd></td></tr>
          <tr><th scope="row">{t('features.every_shortcut')}</th><td><kbd>?</kbd></td></tr>
          <tr><th scope="row">{t('features.playback_details')}</th><td><kbd>I</kbd></td></tr>
          <tr><th scope="row">{t('features.back_to_the_grid')}</th><td><kbd>Esc</kbd> <kbd>Backspace</kbd>{t('features.or_the_mouse_s_back')}</td></tr>
          <tr><th scope="row">{t('features.quit')}</th><td><kbd>Ctrl</kbd>+<kbd>Q</kbd></td></tr>
        </tbody>
      </table>
    </div>
    <p class="muted small section-note" data-reveal><T k="features.right_click_the_picture_for"><kbd slot="kbd1">/</kbd><kbd slot="kbd2">Ctrl</kbd><kbd slot="kbd3">F</kbd><kbd slot="kbd4">Ctrl</kbd><kbd slot="kbd5">,</kbd></T></p>
  </Band>

  <StarCard wave tonal lede={t('features.every_feature_here_started_as')} />

  <Band wave labelledby="next-h" title={t('features.where_to_next')}>
    <Cards>
      {next.map((c) => <LinkCard href={l(c.href)} title={t(c.title)} body={t(c.body)} go={t(c.go)} />)}
    </Cards>
  </Band>

</main>

<ToTop />

<Footer />
</Base>
