---
// Android TV: what the app is like on a television, the ten-foot layout, which devices it runs on,
// and the star card.
import Base from '../../../layouts/Base.astro';
import BgArt from '../../../components/BgArt.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ToTop from '../../../components/ToTop.astro';
import T from '../../../components/T.astro';
import Icon from '../../../components/Icon.astro';
import JsonLd from '../../../components/JsonLd.astro';
import Band from '../../../components/Band.astro';
import Cards from '../../../components/Cards.astro';
import Card from '../../../components/Card.astro';
import DeviceShot from '../../../components/DeviceShot.astro';
import Panel from '../../../components/Panel.astro';
import StarCard from '../../../components/StarCard.astro';
import { langPaths } from '../../../i18n/paths';
import { text } from '../../../i18n/t';
import { l as link } from '../../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://tmplayer.org/" },
    { "@type": "ListItem", "position": 2, "name": "Android TV", "item": "https://tmplayer.org/android-tv/" }
  ]
};

const shot = (name: string, alt: string, light = true) => ({
  src: `/screenshots/${name}.webp`,
  light: light ? `/screenshots/${name}-light.webp` : undefined,
  alt: t(alt),
  width: 960,
  height: 480,
});

// What changes on a television. The next-episode shot has no light twin and a smaller frame.
const features = [
  { title: 'android_tv.a_rail_not_a_menu', body: 'android_tv.every_category_down_the_left', shot: shot('tv-rail', 'android_tv.rail_shot_alt') },
  { title: 'android_tv.sign_in_without_typing', body: 'android_tv.scan_a_qr_code_with', shot: shot('tv-sign-in', 'android_tv.sign_in_shot_alt') },
  { title: 'android_tv.voice_search_from_the_remote', body: 'android_tv.typos_and_missing_accents_still', shot: shot('tv-search', 'android_tv.search_shot_alt') },
  { title: 'android_tv.runs_on_a_1_gb', body: 'android_tv.built_on_a_mi_tv', icon: 'chip-large' },
  { title: 'android_tv.one_video_on_disk_at', body: 'android_tv.the_previous_video_is_cleared', icon: 'sd-card-large' },
  { title: 'android_tv.next_episode_on_its_own', body: 'android_tv.plays_the_next_episode_after', shot: { ...shot('tv-next-episode', 'android_tv.next_episode_shot_alt', false), width: 840, height: 420 } },
];
---
<Base page="android_tv" title={t('android_tv.tmplayer_unofficial_telegram_video_player')} description={t('android_tv.watch_telegram_videos_on_android')}>
  <Fragment slot="head">
    <JsonLd data={breadcrumbs} />
  </Fragment>
{/* Decorative background art, hidden from assistive technology and still under reduced motion. */}
<BgArt />

<Header page="android_tv" />

<main id="main">

  <section class="page-head">
    <div class="wrap page-head-wrap">
      <p class="crumbs"><a href={l('/')}>{t('common.home')}</a><span aria-hidden="true">/</span>Android TV</p>
      <h1><T k="android_tv.a_telegram_video_player"><em slot="em1">{t('android_tv.a_telegram_video_player__em1')}</em></T></h1>
      <p class="page-lede">{t('android_tv.designed_for_a_d_pad')}</p>
      <div class="page-actions">
        <a class="btn btn-filled" href={l('/download/#android-tv')}> <Icon name="download-btn" /> {t('android_tv.download_for_android_tv')}</a>
        <a class="btn btn-outline" href={l('/install/#android-tv')}>{t('android_tv.sideload_it_in_four_steps')} <Icon name="arrow-right-sm" /></a>
      </div>
    </div>
  </section>

  <Icon name="wave" />

  <Band tonal labelledby="tv-h" title={t('android_tv.what_changes_on_a_television')} sub={t('android_tv.same_account_same_apk_only')}>
    <Cards>
      {features.map((f) => <Card title={t(f.title)} body={t(f.body)} shot={f.shot} shotIcon={f.icon} />)}
    </Cards>
  </Band>

  <Icon name="wave-flip" />

  <Band labelledby="tvshots-h" title={t('android_tv.the_ten_foot_layout')} sub={t('android_tv.the_app_on_a_television')}>
    <div class="shots">
      <DeviceShot device="tv" shot={{ src: '/screenshots/tv-chats.webp', light: '/screenshots/tv-chats-light.webp', alt: t('android_tv.the_tmplayer_chat_list_on'), width: 1920, height: 1080 }}><T k="android_tv.categories_on_the_rail_chats"><b slot="b1">{t('android_tv.categories_on_the_rail_chats__b1')}</b></T></DeviceShot>
      <DeviceShot device="tv" shot={{ src: '/screenshots/tv-grid.webp', light: '/screenshots/tv-grid-light.webp', alt: t('android_tv.videos_from_a_telegram_chat'), width: 1920, height: 1080 }}><T k="android_tv.running_time_and_size_on"><b slot="b1">{t('android_tv.running_time_and_size_on__b1')}</b></T></DeviceShot>
    </div>
  </Band>

  <Icon name="wave" />

  <Band tonal labelledby="tvfit-h" title={t('android_tv.will_it_run_on_yours')}>
    <div class="two-col" data-reveal>
      <Panel kind="yes" title={t('android_tv.yes')}>
        <li>{t('android_tv.android_tv_and_google_tv')}</li>
        <li><T k="android_tv.sticks_with_fire_tv"><a href={l('/fire-tv/')} slot="a1">{t('android_tv.sticks_with_fire_tv__a1')}</a></T></li>
        <li>{t('android_tv.boxes_and_tvs_nvidia_shield')}</li>
        <li>{t('android_tv.32_bit_and_64_bit')}</li>
      </Panel>
      <Panel kind="no" title={t('android_tv.no')}>
        <li>{t('android_tv.not_samsung_tizen_not_lg')}</li>
        <li>{t('android_tv.not_apple_tv_and_not')}</li>
        <li>{t('android_tv.not_a_device_where_sideloading')}</li>
      </Panel>
    </div>
  </Band>

  <Icon name="wave-flip" />

  <StarCard tonal lede={t('android_tv.a_tv_app_outside_the')} />

</main>

<ToTop />

<Footer />
</Base>
