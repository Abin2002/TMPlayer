---
// /guides/ in every published language: the six guides, one line each. The crumbs on each guide
// lead back here.
import StarBand from '../../../components/StarBand.astro';
import Base from '../../../layouts/Base.astro';
import BgArt from '../../../components/BgArt.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ToTop from '../../../components/ToTop.astro';
import T from '../../../components/T.astro';
import PageHead from '../../../components/PageHead.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { breadcrumb } from '../../../components/breadcrumb';
import Band from '../../../components/Band.astro';
import Cards from '../../../components/Cards.astro';
import LinkCard from '../../../components/LinkCard.astro';
import Action from '../../../components/guides/Action.astro';
import MoreHelp from '../../../components/guides/MoreHelp.astro';
import { langPaths } from '../../../i18n/paths';
import { text } from '../../../i18n/t';
import { l as link } from '../../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);

// Each guide: its address, the name its own breadcrumb gives it (for the ItemList), the card.
const guides = [
  { path: '/guides/telegram-videos-on-android-tv/', crumb: 'Telegram videos on Android TV', icon: 'tv-card',
    title: 'common.telegram_on_android_tv', body: 'guides.install_tmplayer_on_an_android', go: 'features.read_the_steps' },
  { path: '/guides/telegram-videos-on-fire-tv/', crumb: 'Telegram videos on Fire TV', icon: 'tv-card',
    title: 'common.telegram_on_fire_tv', body: 'guides.install_tmplayer_on_a_fire', go: 'features.read_the_steps' },
  { path: '/guides/telegram-on-tv-without-casting/', crumb: 'Telegram on TV without casting', icon: 'play-card',
    title: 'common.telegram_without_casting', body: 'guides.casting_screen_mirroring_telegram_s', go: 'guide_no_casting.compare_the_options' },
  { path: '/guides/cast-telegram-videos-to-chromecast/', crumb: 'Cast to Chromecast', icon: 'play-card',
    title: 'common.cast_to_chromecast', body: 'guides.cast_card', go: 'features.read_the_steps' },
  { path: '/guides/telegram-on-samsung-or-lg-tv/', crumb: 'Samsung or LG TV', icon: 'tv-card',
    title: 'common.telegram_on_samsung_or_lg', body: 'guides.samsung_lg_card', go: 'guide_no_casting.compare_the_options' },
  { path: '/guides/external-player-for-telegram/', crumb: 'External player', icon: 'play-card',
    title: 'common.external_player', body: 'guides.external_card', go: 'features.read_the_steps' },
];

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: guides.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: g.crumb,
    url: `https://tmplayer.org${g.path}`,
  })),
};
---
<Base page="guides" title={t('guides.guides_to_telegram_on_your')} description={t('guides.how_to_watch_the_videos')}>
  <Fragment slot="head">
    <JsonLd data={breadcrumb(['Guides', '/guides/'])} />
    <JsonLd data={itemList} />
  </Fragment>
{/* Decorative background art, hidden from assistive technology and still under reduced motion. */}
<BgArt />

<Header page="guides" />

<main id="main">

  <PageHead lede={t('guides.lede')} updated="/guides/">
    <Fragment slot="crumbs"><a href={l('/')}>{t('common.home')}</a><span aria-hidden="true">/</span>{t('common.guides')}</Fragment>
    <T slot="title" k="guides.telegram_on_the_tv"><em slot="em1">{t('guides.telegram_on_the_tv__em1')}</em></T>
    <Fragment slot="actions">
      <Action filled href={l('/download/')}>{t('home.download_tmplayer')}</Action>
    </Fragment>
  </PageHead>

  <Band wave tonal id="guides" title={t('guides.pick_a_guide')}>
    <Cards>
      {guides.map((g) => <LinkCard href={l(g.path)} icon={g.icon} title={t(g.title)} body={t(g.body)} go={t(g.go)} />)}
    </Cards>
    <p class="muted small section-note" data-reveal><T k="guides.looking_at_other_apps"><a href={l('/alternatives/')} slot="a1">{t('common.telegram_tv_apps_compared')}</a></T></p>
  </Band>

  <StarBand lede={t('features.every_feature_here_started_as')} />

  <MoreHelp>
    <T k="guide_no_casting.tmplayer_does_not_provide_media"><a href={l('/faq/')} slot="a1">{t('guide_no_casting.tmplayer_does_not_provide_media__a1')}</a></T>
  </MoreHelp>

</main>

<ToTop />

<Footer />
</Base>
