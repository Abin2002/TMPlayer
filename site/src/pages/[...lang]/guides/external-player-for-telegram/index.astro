---
// For the searches "external player for telegram", "reproductor externo para telegram",
// "telegram video player app" and "play telegram videos in vlc": TMPlayer is itself the external
// player, and on Android it hands a video on to VLC, MX Player or any other player. Every claim
// is checked against the app's code: PlayerActivity.openInAnotherApp and ExternalPlayer (the
// resume position saved first, a partial file handed over with a warning, nothing handed over
// with nothing on disk, the download left running), PlayerMenu (the line left out for a chat that
// restricts saving, More options on the phone, More at the end of the TV's row, hold OK), and on
// the desktop the tile and detail menus' Open in another app through OpenExternal.open.
import StarBand from '../../../../components/StarBand.astro';
import GuidePage from '../../../../components/guides/GuidePage.astro';
import PageHead from '../../../../components/PageHead.astro';
import Crumbs from '../../../../components/guides/Crumbs.astro';
import Action from '../../../../components/guides/Action.astro';
import Band from '../../../../components/Band.astro';
import Steps from '../../../../components/Steps.astro';
import Step from '../../../../components/Step.astro';
import Cards from '../../../../components/Cards.astro';
import Card from '../../../../components/Card.astro';
import LinkCard from '../../../../components/LinkCard.astro';
import DeviceShot from '../../../../components/DeviceShot.astro';
import MoreHelp from '../../../../components/guides/MoreHelp.astro';
import T from '../../../../components/T.astro';
import type { Guide } from '../../../../components/guides/ld';
import { langPaths } from '../../../../i18n/paths';
import { english, text } from '../../../../i18n/t';
import { l as link } from '../../../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);
const g = (k: string) => t(`guide_external.${k}`);
const en = (k: string) => english[`guide_external.${k}`];

const steps = [1, 2, 3, 4].map((i) => ({ id: `player-${i}`, name: en(`step_${i}_h`), text: en(`step_${i}_p`) }));
const ld: Guide = {
  path: '/guides/external-player-for-telegram/',
  crumb: en('crumb'),
  headline: en('social_title'),
  description: en('description'),
  datePublished: '2026-10-19',
  howTo: { totalTime: 'PT1M', steps },
};

const what = ['tracks', 'resume', 'stream'];
const gets = ['whole', 'partial', 'nothing', 'protected'];
---
<GuidePage page="guide_external" title={g('title')} socialTitle={g('social_title')} description={g('description')} ld={ld}>

  <PageHead lede={g('lede')} updated={ld.path}>
    <Crumbs slot="crumbs" here={g('crumb')} />
    <T slot="title" k="guide_external.h1"><em slot="em1">{g('h1__em1')}</em></T>
    <Fragment slot="actions">
      <Action filled href="#steps">{t('fire_tv.show_me_the_steps')}</Action>
      <Action href={l('/download/')}>{t('home.download_tmplayer')}</Action>
    </Fragment>
  </PageHead>

  <Band wave tonal id="what" title={g('what_h')} sub={g('what_sub')}>
    <Cards>
      {what.map((w) => <Card title={g(`${w}_h`)}>{g(`${w}_p`)}</Card>)}
    </Cards>
    <div class="shots alt-shots">
      <DeviceShot device="phone" shot={{ src: '/screenshots/phone-show.webp', light: '/screenshots/phone-show-light.webp', alt: t('home.phone_show_page_alt'), width: 1080, height: 2400 }}><T k="alternatives.shot_phone"><b slot="b1">{t('alternatives.shot_phone__b1')}</b></T></DeviceShot>
      <DeviceShot device="desktop" shot={{ src: '/screenshots/desktop-grid.webp', light: '/screenshots/desktop-grid-light.webp', alt: t('features.the_tmplayer_desktop_app_on'), width: 1920, height: 1200 }}><T k="alternatives.shot_desktop"><b slot="b1">{t('alternatives.shot_desktop__b1')}</b></T></DeviceShot>
    </div>
  </Band>

  <Band wave body id="steps" title={g('steps_h')} sub={g('steps_sub')}>
    <Steps>
      {[1, 2, 3, 4].map((i) => (
        <Step id={`player-${i}`} title={g(`step_${i}_h`)} p>{g(`step_${i}_p`)}</Step>
      ))}
    </Steps>
  </Band>

  <StarBand lede={t('features.every_feature_here_started_as')} />

  <Band wave tonal id="gets" title={g('gets_h')}>
    <div class="section-body prose-band" data-reveal>
      <ul class="fact-list">
        {gets.map((x) => <li>{g(`gets_${x}`)}</li>)}
      </ul>
      <p><T k="guide_external.gets_formats"><a href={l('/formats/')} slot="a1">{g('gets_formats__a1')}</a></T></p>
    </div>
  </Band>

  <Band wave id="desktop" title={g('desktop_h')}>
    <div class="section-body prose-band" data-reveal>
      <p>{g('desktop_p1')}</p>
      <p>{g('desktop_p2')}</p>
    </div>
    <Cards>
      <LinkCard href={l('/formats/')} icon="play-card" title={t('common.formats')} body={g('formats_card')} go={t('alternatives.see_the_table')} />
      <LinkCard href={l('/guides/cast-telegram-videos-to-chromecast/')} icon="play-card" title={t('common.cast_to_chromecast')} body={t('guides.cast_card')} go={t('features.read_the_steps')} />
      <LinkCard href={l('/download/')} icon="play-card" title={t('home.download_tmplayer')} body={t('alternatives.download_card')} go={t('common.download')} />
    </Cards>
  </Band>

  <MoreHelp tonal>
    <T k="guide_external.more"><a href={l('/faq/')} slot="a1">{g('more__a1')}</a></T>
  </MoreHelp>

</GuidePage>
