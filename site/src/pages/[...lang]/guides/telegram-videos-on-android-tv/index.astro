---
// The stored theme, applied before the first paint. With no stored choice nothing is set and the stylesheet follows prefers-color-scheme, which is the system theme.

import Base from '../../../../layouts/Base.astro';
import BgArt from '../../../../components/BgArt.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import ToTop from '../../../../components/ToTop.astro';
import T from '../../../../components/T.astro';
import Icon from '../../../../components/Icon.astro';
import JsonLd from '../../../../components/JsonLd.astro';
import { langPaths } from '../../../../i18n/paths';
import { text } from '../../../../i18n/t';
import { l as link } from '../../../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);

const ld0 = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://tmplayer.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Telegram videos on Android TV",
      "item": "https://tmplayer.org/guides/telegram-videos-on-android-tv/"
    }
  ]
};

const ld1 = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "How to watch Telegram videos on Android TV",
  "description": "Watch the videos in your own Telegram chats and channels on an Android TV or Google TV: install TMPlayer, scan a QR code with your phone, and press play.",
  "url": "https://tmplayer.org/guides/telegram-videos-on-android-tv/",
  "mainEntityOfPage": "https://tmplayer.org/guides/telegram-videos-on-android-tv/",
  "image": "https://tmplayer.org/og.png?v=4",
  "inLanguage": "en",
  "datePublished": "2026-10-06",
  "dateModified": "2026-10-06",
  "author": {
    "@type": "Person",
    "name": "dracu-lah",
    "url": "https://nevil.dev"
  },
  "publisher": {
    "@type": "Organization",
    "name": "TMPlayer",
    "url": "https://tmplayer.org/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://tmplayer.org/icon-512.png"
    }
  },
  "about": {
    "@type": "SoftwareApplication",
    "name": "TMPlayer",
    "url": "https://tmplayer.org/"
  }
};

const ld2 = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to watch Telegram videos on Android TV",
  "description": "Watch the videos in your own Telegram chats and channels on an Android TV or Google TV: install TMPlayer, scan a QR code with your phone, and press play.",
  "inLanguage": "en",
  "totalTime": "PT10M",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Check the television",
      "url": "https://tmplayer.org/guides/telegram-videos-on-android-tv/#tv-1",
      "text": "Android TV or Google TV on Android 8.0 or above. Most TVs and sticks sold since 2018 qualify."
    },
    {
      "@type": "HowToStep",
      "name": "Install TMPlayer",
      "url": "https://tmplayer.org/guides/telegram-videos-on-android-tv/#tv-2",
      "text": "Fetch the universal APK on the TV with the free Downloader app, send it from a phone with Send files to TV, or install it with adb."
    },
    {
      "@type": "HowToStep",
      "name": "Sign in with a QR code",
      "url": "https://tmplayer.org/guides/telegram-videos-on-android-tv/#tv-3",
      "text": "Open TMPlayer and scan the code: in Telegram on your phone, Settings, Devices, Link Desktop Device."
    },
    {
      "@type": "HowToStep",
      "name": "Pick a chat and press play",
      "url": "https://tmplayer.org/guides/telegram-videos-on-android-tv/#tv-4",
      "text": "TMPlayer lists the videos in your chats and channels. A video starts within seconds and keeps downloading while it plays."
    }
  ]
};
---
<Base page="guide_android_tv" title={t('guide_android_tv.how_to_watch_telegram_videos')} socialTitle={t('guide_android_tv.how_to_watch_telegram_videos_2')} description={t('guide_android_tv.watch_the_videos_in_your')} ogType="article">
  <Fragment slot="head">
    <JsonLd data={ld0} />
    <JsonLd data={ld1} />
    <JsonLd data={ld2} />
  </Fragment>
<!-- Decorative background art, hidden from assistive technology and still under reduced motion. -->
<BgArt />

<Header page="guide_android_tv" />

<main id="main">

  <section class="page-head">
    <div class="wrap page-head-wrap">
      <p class="crumbs"><a href={l('/')}>{t('common.home')}</a><span aria-hidden="true">/</span><span>{t('common.guides')}</span><span aria-hidden="true">/</span>Android TV</p>
      <h1><T k="guide_android_tv.telegram_videos"><em slot="em1">{t('guide_android_tv.telegram_videos__em1')}</em></T></h1>
      <p class="page-lede">{t('guide_android_tv.telegram_has_no_app_for')}</p>
      <div class="page-actions">
        <a class="btn btn-filled" href="#steps">{t('fire_tv.show_me_the_steps')} <Icon name="arrow-right-sm" /></a>
        <a class="btn btn-outline" href={l('/download/')}>{t('home.download_tmplayer')} <Icon name="arrow-right-sm" /></a>
      </div>
    </div>
  </section>
<Icon name="wave" />
  <section class="band band-tonal" id="fit" aria-labelledby="fit-h">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div class="section-title">
          <h2 id="fit-h">{t('guide_android_tv.what_you_need')}</h2>
        </div>
      </div>
      <div class="two-col" data-reveal>
        <div class="panel">
          <h3><span class="panel-icon icon-yes" aria-hidden="true"><Icon name="tick-panel" /></span><span>{t('guide_android_tv.you_need')}</span></h3>
          <ul class="ticks">
            <li>{t('guide_android_tv.an_android_tv_or_google')}</li>
            <li>{t('guide_android_tv.your_telegram_account_signed_in')}</li>
            <li>{t('guide_android_tv.a_network_connection_wi_fi')}</li>
          </ul>
        </div>
        <div class="panel">
          <h3><span class="panel-icon icon-no" aria-hidden="true"><Icon name="cross-panel" /></span><span>{t('guide_android_tv.you_do_not_need')}</span></h3>
          <ul class="crosses">
            <li>{t('guide_android_tv.a_bot_a_server_or')}</li>
            <li>{t('guide_android_tv.to_move_any_files_the')}</li>
            <li>{t('guide_android_tv.a_computer_unless_you_prefer')}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
<Icon name="wave-flip" />
  <section class="band" id="steps" aria-labelledby="steps-h">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div class="section-title">
          <h2 id="steps-h">{t('guide_android_tv.four_steps')}</h2>
          <p class="section-sub">{t('guide_android_tv.you_do_the_first_three')}</p>
        </div>
      </div>
      <div class="section-body" data-reveal>
        <ol class="steps">
          <li id="tv-1">
            <h3>{t('guide_android_tv.check_the_television')}</h3>
            <p><T k="guide_android_tv.open_and_look_for_the"><em slot="em1">{t('guide_android_tv.open_and_look_for_the__em1')}</em><em slot="em2">{t('guide_android_tv.open_and_look_for_the__em2')}</em><em slot="em3">{t('guide_android_tv.open_and_look_for_the__em3')}</em></T></p>
          </li>
          <li id="tv-2">
            <h3>{t('guide_android_tv.install_tmplayer')}</h3>
            <p><T k="guide_android_tv.play_store_apk"><em slot="em1">Downloader</em><code slot="code1">tmplayer.org/apk</code></T></p>
            <p><T k="guide_android_tv.prefer_a_phone_or_a"><a href={l('/install/#android-tv')} slot="a1">{t('guide_android_tv.prefer_a_phone_or_a__a1')}</a></T></p>
          </li>
          <li id="tv-3">
            <h3>{t('guide_android_tv.sign_in_with_a_qr')}</h3>
            <p><T k="guide_android_tv.open_tmplayer_it_shows_a"><em slot="em1">{t('guide_android_tv.open_tmplayer_it_shows_a__em1')}</em><em slot="em2">{t('guide_android_tv.open_tmplayer_it_shows_a__em2')}</em><em slot="em3">{t('guide_android_tv.open_tmplayer_it_shows_a__em3')}</em></T></p>
          </li>
          <li id="tv-4">
            <h3>{t('install.pick_a_chat_and_press')}</h3>
            <p>{t('guide_android_tv.your_chats_channels_and_saved')}</p>
          </li>
        </ol>
      </div>
    </div>
  </section>
<Icon name="wave" />
  <section class="band band-tonal" id="tips" aria-labelledby="tips-h">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div class="section-title">
          <h2 id="tips-h">{t('guide_android_tv.worth_knowing')}</h2>
        </div>
      </div>
      <div class="card-grid card-grid-3" data-reveal>
        <div class="card">
          <h3>{t('guide_android_tv.subtitles_and_audio_tracks')}</h3>
          <p><T k="guide_android_tv.mkv_mp4_avi_and_ts"><a href={l('/formats/')} slot="a1">{t('guide_android_tv.mkv_mp4_avi_and_ts__a1')}</a></T></p>
        </div>
        <div class="card">
          <h3>{t('guide_android_tv.series_play_on')}</h3>
          <p>{t('guide_android_tv.when_an_episode_ends_the')}</p>
        </div>
        <div class="card">
          <h3>{t('guide_android_tv.slow_connection')}</h3>
          <p>{t('guide_android_tv.turn_on_the_mode_that')}</p>
        </div>
      </div>
    </div>
  </section>
<Icon name="wave-flip" />
  <section class="band" id="more" aria-labelledby="more-h">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div class="section-title">
          <h2 id="more-h">{t('guide_android_tv.more_help')}</h2>
        </div>
      </div>
      <p class="muted small section-note" data-reveal><T k="guide_android_tv.questions_about_privacy_and_what"><a href={l('/faq/')} slot="a1">{t('guide_android_tv.questions_about_privacy_and_what__a1')}</a><a href="/security/" slot="a2">{t('guide_android_tv.questions_about_privacy_and_what__a2')}</a><a href={l('/guides/telegram-videos-on-fire-tv/')} slot="a3">{t('guide_android_tv.questions_about_privacy_and_what__a3')}</a></T></p>

      <div class="support support-slim" data-reveal>
          <!-- The coffee and sponsor links, the same block and words as on the download page, so a
               reader who got something from this page has the offer where they finished reading. -->
          <div class="support-more support-more-solo" id="sponsor">
            <h3>{t('home.support_tmplayer')}</h3>
            <p>{t('home.support_no_ads')}</p>
            <div class="support-actions support-give">
              <a class="btn btn-filled" href="https://github.com/sponsors/dracu-lah" rel="noopener"> <Icon name="heart-btn" /> {t('home.sponsor_on_github')}</a>
              <a class="btn btn-outline" href="https://buymeacoffee.com/nevil.dev" rel="noopener"> <Icon name="coffee-btn" /> {t('home.buy_me_a_coffee')}</a>
            </div>
          </div>
      </div>
    </div>
  </section>

</main>

<ToTop />

<Footer />
</Base>
