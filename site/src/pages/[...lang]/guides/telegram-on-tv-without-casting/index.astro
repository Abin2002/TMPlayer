---
import GuidePage from '../../../../components/guides/GuidePage.astro';
import GuideHead from '../../../../components/guides/GuideHead.astro';
import Action from '../../../../components/guides/Action.astro';
import Band from '../../../../components/Band.astro';
import Cards from '../../../../components/guides/Cards.astro';
import Card from '../../../../components/guides/Card.astro';
import MoreHelp from '../../../../components/guides/MoreHelp.astro';
import T from '../../../../components/T.astro';
import type { Guide } from '../../../../components/guides/ld';
import { langPaths } from '../../../../i18n/paths';
import { text } from '../../../../i18n/t';
import { l as link } from '../../../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);

// An explainer rather than a walkthrough, so an Article and no HowTo.
const ld: Guide = {
  path: '/guides/telegram-on-tv-without-casting/',
  crumb: 'Telegram on TV without casting',
  headline: 'Telegram on your TV without casting',
  description: 'Watch Telegram videos on a television without casting or mirroring your phone: a player on the TV itself signs in to your account and streams the videos in your chats.',
  datePublished: '2026-10-06',
  dateModified: '2026-10-14',
};

// The ways to get Telegram onto a television, compared: heading key, then its text.
const ways = [
  ['guide_no_casting.screen_mirroring_from_the_phone', 'guide_no_casting.works_with_most_tvs_but'],
  ['guide_no_casting.a_laptop_on_an_hdmi', 'guide_no_casting.telegram_desktop_plays_videos_fine'],
  ['guide_no_casting.downloading_and_copying_files', 'guide_no_casting.save_the_video_put_it'],
  ['guide_no_casting.a_player_on_the_tv', 'guide_no_casting.tmplayer_runs_on_the_android'],
];
---
<GuidePage page="guide_no_casting" title={t('guide_no_casting.telegram_on_your_tv_without')} socialTitle={t('guide_no_casting.telegram_on_your_tv_without_2')} description={t('guide_no_casting.watch_telegram_videos_on_a')} ld={ld}>

  <GuideHead lede={t('guide_no_casting.mirroring_a_phone_onto_a')}>
    <T slot="crumbs" k="guide_no_casting.without_casting"><a href={l('/')} slot="a1">{t('guide_no_casting.without_casting__a1')}</a><span aria-hidden="true" slot="span1">/</span><span slot="span2">{t('guide_no_casting.without_casting__span2')}</span><span aria-hidden="true" slot="span3">/</span></T>
    <T slot="title" k="guide_no_casting.telegram_on_the_tv"><em slot="em1">{t('guide_no_casting.telegram_on_the_tv__em1')}</em></T>
    <Fragment slot="actions">
      <Action filled href={l('/download/')}>{t('home.download_tmplayer')}</Action>
      <Action href="#compare">{t('guide_no_casting.compare_the_options')}</Action>
    </Fragment>
  </GuideHead>

  <Band wave tonal id="compare" title={t('guide_no_casting.the_ways_to_get_telegram')}>
    <div class="formats" data-reveal>
      {ways.map(([title, body]) => (
        <div class="format">
          <h3>{t(title)}</h3>
          <p>{t(body)}</p>
        </div>
      ))}
    </div>
  </Band>

  <Band wave id="how" title={t('guide_no_casting.how_tmplayer_does_it')} sub={t('guide_no_casting.no_casting_no_copies_no')}>
    <Cards>
      <Card title={t('guide_no_casting.it_is_a_telegram_client')}>{t('guide_no_casting.tmplayer_signs_in_with_telegram')}</Card>
      <Card title={t('guide_no_casting.it_streams_as_it_downloads')}>{t('guide_no_casting.a_video_starts_within_seconds')}</Card>
      <Card title={t('guide_no_casting.it_is_built_for_the')}>{t('guide_no_casting.a_ten_foot_layout_for')}</Card>
    </Cards>
  </Band>

  <Band wave tonal id="devices" title={t('guide_no_casting.which_tv_do_you_have')}>
    <Cards>
      <Card title={t('guide_no_casting.android_tv_or_google_tv')}><T k="guide_no_casting.install_the_apk_and_sign"><a href={l('/guides/telegram-videos-on-android-tv/')} slot="a1">{t('guide_no_casting.install_the_apk_and_sign__a1')}</a></T></Card>
      <Card title="Fire TV"><T k="guide_no_casting.install_it_with_the_downloader"><a href={l('/guides/telegram-videos-on-fire-tv/')} slot="a1">{t('guide_no_casting.install_it_with_the_downloader__a1')}</a></T></Card>
      <Card title={t('guide_no_casting.a_pc_next_to_the')}><T k="guide_no_casting.tmplayer_also_runs_on_windows"><a href={l('/download/')} slot="a1">{t('guide_no_casting.tmplayer_also_runs_on_windows__a1')}</a></T></Card>
    </Cards>
  </Band>

  <MoreHelp>
    <T k="guide_no_casting.tmplayer_does_not_provide_media"><a href={l('/faq/')} slot="a1">{t('guide_no_casting.tmplayer_does_not_provide_media__a1')}</a></T>
  </MoreHelp>

</GuidePage>
