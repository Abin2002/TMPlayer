---
import Base from '../../../layouts/Base.astro';
import BgArt from '../../../components/BgArt.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ToTop from '../../../components/ToTop.astro';
import T from '../../../components/T.astro';
import Icon from '../../../components/Icon.astro';
import PageHead from '../../../components/PageHead.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { breadcrumb } from '../../../components/breadcrumb';
import Band from '../../../components/Band.astro';
import FaqItem from '../../../components/FaqItem.astro';
import Panel from '../../../components/Panel.astro';
import StarCard from '../../../components/StarCard.astro';
import { faqLd } from '../../../components/faq/ld';
import { langPaths } from '../../../i18n/paths';
import { english, format, text } from '../../../i18n/t';
import { ldKey } from '../../../i18n/ld';
import { l as link } from '../../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);


// The questions, in the order of the FAQPage JSON-LD. An answer with `href` links its {a1} words.
// The security page is English only, so its link is not moved into the language.
//
// A question with `ld` (its English name) is written only in the JSON-LD and shows the same ld.*
// strings on the page, so the two cannot drift; `more` puts a link after its answer.
type Question =
  | { q: string; a: string; href?: string; id?: string }
  | { ld: string; more?: { k: string; href: string } };
const questions: Question[] = [
  { ld: 'Can I watch Telegram videos on Android TV?', more: { k: 'guide_no_casting.install_the_apk_and_sign__a1', href: l('/guides/telegram-videos-on-android-tv/') } },
  { ld: 'Is there a Telegram app for Fire TV Stick?', more: { k: 'guide_no_casting.install_it_with_the_downloader__a1', href: l('/guides/telegram-videos-on-fire-tv/') } },
  { ld: 'How do I play Telegram videos on a PC or Mac?', more: { k: 'faq.which_file_answer__a1', href: l('/download/') } },
  { ld: 'Is TMPlayer free? Is there a paid version?' },
  { ld: 'Is TMPlayer safe? Can it read my messages?', more: { k: 'faq.neither_the_app_talks_to__a1', href: '/security/' } },
  { ld: 'Is it the same as the official Telegram app?' },
  { ld: 'Do I need a phone to sign in?' },
  { ld: 'Does it play music and audio files?', more: { k: 'faq.mkv_mp4_avi_and_ts__a1', href: l('/formats/') } },
  { q: 'faq.do_i_have_to_wait', a: 'faq.no_it_starts_in_seconds' },
  { q: 'faq.is_there_a_server_or', a: 'faq.neither_the_app_talks_to', href: '/security/' },
  { q: 'faq.which_file_do_i_download', a: 'faq.which_file_answer', href: l('/download/') },
  { q: 'faq.is_there_a_windows_macos_linux', a: 'faq.yes_for_windows_10_11_macos', href: l('/download/'), id: 'desktop' },
  { q: 'faq.does_tmplayer_provide_any_media', a: 'faq.no_it_hosts_uploads_sells' },
  { q: 'faq.how_much_storage_does_it', a: 'faq.one_video_at_a_time' },
  { q: 'faq.which_video_formats_does_it', a: 'faq.mkv_mp4_avi_and_ts', href: l('/formats/') },
  { q: 'faq.how_does_it_update_if', a: 'faq.it_checks_github_and_asks' },
  { q: 'faq.is_tmplayer_affiliated_with_telegram', a: 'faq.no_it_is_an_unofficial' },
  { q: 'faq.is_tmplayer_the_same_as_tmp', a: 'faq.no_tmp_is_a_different_app' },
];

// Every question on the page is in the JSON-LD, in the same place, or the build stops.
const ldAnswers = new Map(faqLd.mainEntity.map((e) => [e.name, e.acceptedAnswer.text]));
const onPage = questions.map((x) => ('ld' in x ? x.ld : english[x.q]));
if (onPage.join('\n') !== faqLd.mainEntity.map((e) => e.name).join('\n')) {
  throw new Error('the FAQ page and its FAQPage JSON-LD list different questions');
}
------
<Base page="faq" title={t('faq.tmplayer_faq_unofficial_telegram_video')} description={t('faq.answers_about_tmplayer_streaming_without')}>
  <Fragment slot="head">
    <JsonLd data={breadcrumb(['Questions', '/faq/'])} />
    <JsonLd data={faqLd} />
  </Fragment>
{/* Decorative background art, hidden from assistive technology and still under reduced motion. */}
<BgArt />

<Header page="faq" />

<main id="main">

  <PageHead lede={t('faq.including_the_ones_about_trust')} updated="/faq/">
    <Fragment slot="crumbs"><T k="faq.questions"><a href={l('/')} slot="a1">{t('faq.questions__a1')}</a><span aria-hidden="true" slot="span1">/</span></T></Fragment>
    <Fragment slot="title"><T k="faq.questions_2"><em slot="em1">{t('faq.questions_2__em1')}</em></T></Fragment>
    <Fragment slot="actions">
      <a class="btn btn-filled" href={l('/download/')}> <Icon name="download-btn" /> {t('common.download')}</a>
      <a class="btn btn-outline" href={l('/features/')}>{t('home.what_it_does')} <Icon name="arrow-right-sm" /></a>
    </Fragment>
  </PageHead>

    <Band wave id="faq" labelledby="faq-h" tonal title={t('faq.common_questions')} sub={format(lang, 'faq.short_questions_open_the_one', { count: questions.length.toLocaleString(lang.tag === 'en' ? 'en-GB' : lang.tag) })}>
    {/* A real accordion, built from native details and summary, so it opens with a keyboard, is
        announced as a disclosure, and works with JavaScript off. The height animation lives on
        the inner .faq-body, since details itself cannot be transitioned. */}
    <div class="faq" data-reveal>
      {questions.map((x) => 'ld' in x ? (
        <FaqItem q={t(ldKey(x.ld))} name="faq">{t(ldKey(ldAnswers.get(x.ld)!))}{x.more && <> <a href={x.more.href}>{t(x.more.k)}</a></>}</FaqItem>
      ) : (
        <FaqItem q={t(x.q)} name="faq" id={x.id}>{x.href ? <T k={x.a}><a href={x.href} slot="a1">{t(`${x.a}__a1`)}</a></T> : t(x.a)}</FaqItem>
      ))}
    </div>
  </Band>

    <Band wave id="about" labelledby="about-h" title={t('faq.what_it_is_and_what')} sub={t('faq.a_player_pointed_at_an')}>
    <div class="two-col" data-reveal>
      <Panel kind="yes" title={t('faq.what_it_is')}>
        <li><T k="faq.a_player_for_telegram_account"><strong slot="strong1">{t('faq.a_player_for_telegram_account__strong1')}</strong></T></li>
        <li><T k="faq.a_way_to_watch_videos"><strong slot="strong1">{t('faq.a_way_to_watch_videos__strong1')}</strong></T></li>
        <li>{t('faq.free_and_open_source_you')}</li>
      </Panel>
      <Panel kind="no" title={t('home.what_it_is_not')}>
        <li>{t('faq.not_a_media_service_or')}</li>
        <li>{t('faq.not_a_telegram_app_you')}</li>
        <li>{t('faq.not_affiliated_with_telegram_fz')}</li>
      </Panel>
    </div>

    <p class="muted small section-note" data-reveal><T k="faq.the_lists_what_stays_on"><a href="/privacy/" slot="a1">{t('faq.the_lists_what_stays_on__a1')}</a><a href="/legal/" slot="a2">{t('faq.the_lists_what_stays_on__a2')}</a></T></p>
  </Band>

    <StarCard wave tonal lede={t('faq.no_money_no_account_no')} />

</main>

<ToTop />

<Footer />
</Base>
