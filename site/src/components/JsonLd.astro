---
// A JSON-LD block written in English; on a translated page its text fields come from the ld.*
// catalog strings and its tmplayer.org URLs move into the language.
import { translateLd } from '../i18n/ld';

interface Props { data: unknown }
const lang = Astro.locals.lang;
const data = lang.path ? translateLd(Astro.props.data, lang) : Astro.props.data;
const body = '\n' + JSON.stringify(data, null, 2).replace(/<\//g, '<\\/') + '\n';
---
<script type="application/ld+json" set:html={body} is:inline></script>
