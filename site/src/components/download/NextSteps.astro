---
// What comes after the click: an inline panel, never an overlay, that app.js moves under the
// download row that was pressed (or under the page head's button) and opens there, with the next
// steps for that platform and the two things a reader who just took the file may well do next,
// follow the channel for new versions and star the project. It stays closed with scripting off,
// and for a click that only opened the release page on GitHub, since then nothing is downloading.
//
// Every step is the install page's own sentence, so the two pages cannot drift apart and the
// translations already cover them. Only the heading, the Windows step title and the channel link
// are new. The heading is a heading for assistive technology only by role, because the panel lands
// under an h1 in the page head and under an h3 in a platform card: app.js gives it the level of
// the place it lands in.
import Icon from '../Icon.astro';
import T from '../T.astro';
import { text } from '../../i18n/t';
import { l as link } from '../../i18n/links';

const lang = Astro.locals.lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);
---
<section class="next-steps" id="next-steps" aria-labelledby="next-steps-h" hidden>
  <p class="next-steps-h" id="next-steps-h" role="heading" aria-level="3"><Icon name="download-sm" /> {t('download.what_comes_next')}</p>

  <div data-next="android" hidden>
    <ol class="tour-list">
      <li><div><p class="next-step-h">{t('install.phone_step2_h')}</p><p><T k="install.phone_step2"><em slot="em1">{t('install.phone_step2__em1')}</em></T></p></div></li>
      <li><div><p class="next-step-h">{t('home.sign_in')}</p><p>{t('install.phone_step3')}</p></div></li>
    </ol>
    <p class="next-more"><a href={l('/install/#android')}>{t('download.how_to_install_on_a')}</a></p>
  </div>

  <div data-next="android-tv" hidden>
    <p class="next-lede"><T k="download.tv_note"><code slot="code1">tmplayer.org/apk</code></T></p>
    <ol class="tour-list">
      <li><div><p class="next-step-h">{t('install.tv_step1_h')}</p><p><T k="install.tv_step1"><em slot="em1">Downloader</em></T></p></div></li>
      <li><div><p class="next-step-h">{t('install.tv_step2_h')}</p><pre class="code"><code>tmplayer.org/apk</code></pre><p><T k="install.tv_step2"><em slot="em1">{t('install.tv_step2__em1')}</em></T></p></div></li>
      <li><div><p class="next-step-h">{t('install.tv_step3_h')}</p><p><T k="install.tv_step3"><em slot="em1">{t('install.tv_step3__em1')}</em><em slot="em2">{t('install.tv_step3__em2')}</em><em slot="em3">{t('install.tv_step3__em3')}</em><em slot="em4">{t('install.tv_step3__em4')}</em><em slot="em5">{t('install.tv_step3__em5')}</em><em slot="em6">{t('install.tv_step3__em6')}</em></T></p></div></li>
    </ol>
    <p class="next-more"><a href={l('/install/#android-tv')}>{t('download.how_to_install_on_a_2')}</a></p>
  </div>

  <div data-next="windows" hidden>
    <ol class="tour-list">
      <li><div><p class="next-step-h">{t('download.open_the_installer')}</p><p><T k="download.win_msi_note"><em slot="em1">{t('download.win_msi_note__em1')}</em><em slot="em2">{t('download.win_msi_note__em2')}</em></T></p></div></li>
      <li><div><p class="next-step-h">{t('install.win_step3_h')}</p><p>{t('install.win_step3')} <T k="install.scan_the_qr_code_with"><em slot="em1">{t('install.scan_the_qr_code_with__em1')}</em><em slot="em2">{t('install.scan_the_qr_code_with__em2')}</em><em slot="em3">{t('install.scan_the_qr_code_with__em3')}</em><em slot="em4">{t('install.scan_the_qr_code_with__em4')}</em></T></p></div></li>
    </ol>
    <div class="callout">
      <p><T k="download.win_cmd_steps"><em slot="em1">{t('download.win_cmd_steps__em1')}</em><em slot="em2">{t('download.win_cmd_steps__em2')}</em><a href={l('/install/#windows')} slot="a1">{t('download.win_cmd_steps__a1')}</a></T></p>
      <pre class="abi-cmd"><code>irm https://tmplayer.org/install.ps1 | iex</code></pre>
    </div>
  </div>

  <div data-next="macos" hidden>
    <ol class="tour-list">
      <li><div><p class="next-step-h">{t('install.mac_step1_h')}</p></div></li>
      <li><div><p class="next-step-h">{t('install.mac_step2_h')}</p><p><T k="install.mac_step2"><em slot="em1">{t('install.mac_step2__em1')}</em><em slot="em2">{t('install.mac_step2__em2')}</em></T></p><p><T k="install.mac_step2b"><em slot="em1">{t('install.mac_step2b__em1')}</em><em slot="em2">{t('install.mac_step2b__em2')}</em><em slot="em3">{t('install.mac_step2b__em3')}</em><em slot="em4">{t('install.mac_step2b__em4')}</em><em slot="em5">{t('install.mac_step2b__em5')}</em></T></p></div></li>
      <li><div><p class="next-step-h">{t('home.sign_in')}</p><p><T k="install.scan_the_qr_code_with"><em slot="em1">{t('install.scan_the_qr_code_with__em1')}</em><em slot="em2">{t('install.scan_the_qr_code_with__em2')}</em><em slot="em3">{t('install.scan_the_qr_code_with__em3')}</em><em slot="em4">{t('install.scan_the_qr_code_with__em4')}</em></T></p></div></li>
    </ol>
    <p class="next-more"><a href={l('/install/#macos')}>{t('download.how_to_install_on_macos')}</a></p>
  </div>

  <div data-next="linux" hidden>
    <ol class="tour-list">
      <li><div><p class="next-step-h">{t('install.linux_step2_h')}</p><p>{t('install.linux_step2_where')}</p><pre class="code"><code>cd ~/Downloads
chmod +x <span data-name="linux-x64-appimage">TMPlayer-&lt;version&gt;-x86_64.AppImage</span>
./<span data-name="linux-x64-appimage">TMPlayer-&lt;version&gt;-x86_64.AppImage</span></code></pre></div></li>
      <li><div><p class="next-step-h">{t('home.sign_in')}</p><p><T k="install.scan_the_qr_code_with"><em slot="em1">{t('install.scan_the_qr_code_with__em1')}</em><em slot="em2">{t('install.scan_the_qr_code_with__em2')}</em><em slot="em3">{t('install.scan_the_qr_code_with__em3')}</em><em slot="em4">{t('install.scan_the_qr_code_with__em4')}</em></T></p></div></li>
    </ol>
    <p class="next-more"><a href={l('/install/#linux')}>{t('download.how_to_install_on_linux')}</a></p>
  </div>

  <div class="next-follow">
    <a class="btn btn-outline" href="https://t.me/tmplayerapp" rel="noopener"><Icon name="telegram-btn" /> {t('download.join_the_telegram_channel_for_updates')}</a>
    <a class="btn btn-outline" href="https://github.com/dracu-lah/TMPlayer" rel="noopener"><Icon name="star-btn" /> {t('home.star_on_github')}</a>
  </div>
</section>
