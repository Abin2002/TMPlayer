---
// One file row in a platform card. With `asset`, app.js swaps in the release file itself, its size
// and its real name (into data-file, data-size and data-dl); until then, or with scripting off, the
// button is a working link to the latest release page. Without `asset` the row links to `href`
// with `label` and nothing is filled in.
import Icon from '../Icon.astro';
import { text } from '../../i18n/t';

interface Props {
  asset?: string;
  href?: string;
  label?: string;
}
const { asset, href, label } = Astro.props;
const t = (k: string) => text(Astro.locals.lang, k);
---
<li class="abi" data-asset={asset} data-primary={asset !== undefined ? '' : undefined}>
                <div class="abi-text">
                  <p class="abi-name"><slot name="name" /></p>
                  <p class="abi-note"><slot name="note" /></p>
                  <slot name="file" />
                </div>
                <div class="abi-get">
                  {asset !== undefined ? (
                  <Fragment>
                  <span class="abi-size" data-size></span>
                  <a class="dl" data-dl href="https://github.com/dracu-lah/TMPlayer/releases/latest" rel="noopener"><Icon name="download-sm" /><span>{t('common.download')}</span></a>
                  </Fragment>
                  ) : (
                  <a class="dl" href={href} rel="noopener"><span>{label}</span></a>
                  )}
                </div>
              </li>
