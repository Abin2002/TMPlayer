---
// A panel with an icon beside its heading and a list under it.
import Icon from '../Icon.astro';

interface Props { tone: 'yes' | 'no'; icon: string; title: string; list: 'ticks' | 'crosses' }
const { tone, icon, title, list } = Astro.props;
---
<div class="panel">
          <h3> <span class={`panel-icon icon-${tone}`} aria-hidden="true">
              <Icon name={icon} />
            </span> {title}</h3>
          <ul class={list}>
            <slot />
          </ul>
        </div>
