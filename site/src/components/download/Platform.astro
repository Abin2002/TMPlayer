---
// One platform's card. app.js finds it by its id and data-os, shows the "your device" badge on the
// one that matches the visitor, and fills the rows (AbiRow) inside it. The rows go in the default
// slot, then the "foot" slot (the install link line) and anything after it in "after".
import Icon from '../Icon.astro';
import { text } from '../../i18n/t';

interface Props {
  id: string;
  icon: string;
  tone: 'yes' | 'no' | 'play' | 'browse';
  title: string;
  req: string;
  computer?: boolean;
  hidden?: boolean;
}
const { id, icon, tone, title, req, computer = false, hidden = false } = Astro.props;
const t = (k: string) => text(Astro.locals.lang, k);
---
<article class="platform" id={id} data-os={id} aria-labelledby={`${id}-h`} hidden={hidden}>
            <div class="platform-head">
              <span class={`panel-icon icon-${tone}`} aria-hidden="true">
                <Icon name={icon} />
              </span>
              <div class="platform-title">
                <h3 id={`${id}-h`}>{title}</h3>
                <p class="platform-req">{req}</p>
              </div>
              <span class="badge platform-yours" hidden>{t(computer ? 'download.your_computer' : 'download.your_device')}</span>
            </div>
            <slot name="before" />
            <ul class="abi-list">
              <slot />
            </ul>
            <p class="platform-foot"><slot name="foot" /></p>
            <slot name="after" />
          </article>
