---
// One band of the security page, after its wave: tonal bands follow a wave, plain ones a flipped
// wave. With a title it opens with the section head; the report band brings its own heading.
// The heading's id is always `<id>-h`. A sub with links goes in the "sub" slot instead.
import Icon from '../Icon.astro';

interface Props { id: string; tonal?: boolean; title?: string; sub?: string }
const { id, tonal = false, title, sub } = Astro.props;
---
<Icon name={tonal ? 'wave' : 'wave-flip'} />
<section class={tonal ? 'band band-tonal' : 'band'} id={id} aria-labelledby={`${id}-h`}>
  <div class="wrap">
    {title && (
      <div class="section-head" data-reveal>
        <div class="section-title">
          <h2 id={`${id}-h`}>{title}</h2>
          <p class="section-sub">{sub}<slot name="sub" /></p>
        </div>
      </div>
    )}
    <slot />
  </div>
</section>
