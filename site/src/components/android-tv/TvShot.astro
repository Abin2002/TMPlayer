---
// A full screenshot inside the drawn television, stand and foot included. The caption comes in
// the slot, since it carries inline markup.
interface Props { src: string; light: string; alt: string }
const { src, light, alt } = Astro.props;
---
<figure class="shot" data-reveal>
  <div class="device device-tv">
    <div class="screen">
      <picture>
        <source data-theme-src srcset={light} media="(prefers-color-scheme: light)">
        <img src={src} alt={alt} width="1920" height="1080" loading="lazy" decoding="async">
      </picture>
    </div>
    <div class="stand"></div>
    <div class="foot"></div>
  </div>
  <figcaption><slot /></figcaption>
</figure>
