---
// A band's heading block: the h2 (with the id its band is labelled by) and the line under it, when
// there is one. The line takes either the `sub` string or a "sub" slot (for a <T> with markup).
// Extra lines go in the default slot, inside the title block.
interface Props { id: string; title: string; sub?: string }
const { id, title, sub } = Astro.props;
const subHtml = Astro.slots.has('sub') ? await Astro.slots.render('sub') : '';
---
<div class="section-head" data-reveal>
  <div class="section-title">
    <h2 id={id}>{title}</h2>
    {(sub || subHtml) && <p class="section-sub">{sub}<Fragment set:html={subHtml} /></p>}
    <slot />
  </div>
</div>
