---
// The Buy Me a Coffee button, in Buy Me a Coffee's own colours: their yellow (#FFDD00, the brand
// kit's) with their near-black text and their cup, as their official buttons have it. The words
// are the page's own catalog string, so the button arrives translated; the cup is the official
// artwork from public/brand/, never redrawn. It is the first way to chip in wherever the site asks
// (user, 2026-10-18), with GitHub Sponsors as the quieter link beside it.
//
// The cup is a small image, lazy, under a versioned URL vercel.json caches for a year.
import { versioned } from '../lib/asset-version';
import { BMC_URL } from '../lib/support';

interface Props { label: string; large?: boolean; newTab?: boolean; class?: string }
const { label, large = false, newTab = false, class: extra } = Astro.props;
---
<a class:list={['btn', 'btn-bmc', { 'btn-bmc-lg': large }, extra]} href={BMC_URL} rel="noopener" target={newTab ? '_blank' : undefined}>
  <img class="bmc-cup" src={versioned('/brand/bmc-cup-on-yellow.svg')} alt="" width="14" height="20" loading="lazy" decoding="async">
  <span>{label}</span>
</a>
