---
// The frame of a guide page: the layout with the guide's JSON-LD, the background art, the
// header, the page's bands in <main>, the back-to-top button and the footer.
// The stored theme, applied before the first paint by the layout. With no stored choice nothing is
// set and the stylesheet follows prefers-color-scheme, which is the system theme.
import Base from '../../layouts/Base.astro';
import BgArt from '../BgArt.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import ToTop from '../ToTop.astro';
import JsonLd from '../JsonLd.astro';
import { guideLd, type Guide } from './ld';
import type { PageId } from '../../i18n/langs';

interface Props {
  page: PageId;
  title: string;
  /** og:title and twitter:title, which on the guides differ from the <title> */
  socialTitle: string;
  description: string;
  ld: Guide;
}
const { page, title, socialTitle, description, ld } = Astro.props;
---
<Base page={page} title={title} socialTitle={socialTitle} description={description} ogType="article">
  <Fragment slot="head">
    {guideLd(ld).map((data) => <JsonLd data={data} />)}
  </Fragment>
  {/* Decorative background art, hidden from assistive technology and still under reduced motion. */}
  <BgArt />

  <Header page={page} />

  <main id="main">
    <slot />
  </main>

  <ToTop />

  <Footer />
</Base>
