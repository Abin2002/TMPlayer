---
// Home / Guides / the device: the guide trail, through the guides hub.
import { text } from '../../i18n/t';
import { l } from '../../i18n/links';

interface Props { here: string }
const { here } = Astro.props;
const lang = Astro.locals.lang;
---
<a href={l(lang, '/')}>{text(lang, 'common.home')}</a><span aria-hidden="true">/</span><a href={l(lang, '/guides/')}>{text(lang, 'common.guides')}</a><span aria-hidden="true">/</span>{here}
