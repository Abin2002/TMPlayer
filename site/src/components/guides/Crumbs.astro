---
// Home / Guides / the device: the guide trail, with Guides as plain text since it has no page.
import { text } from '../../i18n/t';
import { l } from '../../i18n/links';

interface Props { here: string }
const { here } = Astro.props;
const lang = Astro.locals.lang;
---
<a href={l(lang, '/')}>{text(lang, 'common.home')}</a><span aria-hidden="true">/</span><span>{text(lang, 'common.guides')}</span><span aria-hidden="true">/</span>{here}
