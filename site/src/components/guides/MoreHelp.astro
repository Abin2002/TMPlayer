---
// The last band of a guide: where to read on, then the sponsor offer. `download` puts the download
// card before the offer, for a guide with no download button of its own: its value is the card's
// second link (DownloadCard's `more`).
import Band from '../Band.astro';
import DownloadCard from '../DownloadCard.astro';
import SponsorOffer from '../SponsorOffer.astro';
import { text } from '../../i18n/t';

interface Props { download?: { href: string; label: string } }
const { download } = Astro.props;
---
<Band wave id="more" title={text(Astro.locals.lang, 'guide_android_tv.more_help')}>
  <p class="muted small section-note" data-reveal><slot /></p>

  {download && <DownloadCard more={download} />}
  <SponsorOffer slim />
</Band>
