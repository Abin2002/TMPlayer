---
// What a reader needs (ticks) beside what they do not (crosses).
import Panel from '../Panel.astro';

interface Side { title: string; items: string[] }
interface Props { yes: Side; no: Side }
const { yes, no } = Astro.props;
---
<div class="two-col" data-reveal>
  <Panel kind="yes" title={yes.title} compact>
    {yes.items.map((item) => <li>{item}</li>)}
  </Panel>
  <Panel kind="no" title={no.title} compact>
    {no.items.map((item) => <li>{item}</li>)}
  </Panel>
</div>
