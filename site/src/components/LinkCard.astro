---
// A whole-card link: an optional icon in a tile, a heading, one line, and the go label with an
// arrow at its foot.
import Icon from './Icon.astro';

interface Props { href: string; title: string; body: string; go: string; icon?: string }
const { href, title, body, go, icon } = Astro.props;
---
<a class="card" href={href}>
  {icon && (
    <span class="card-icon" aria-hidden="true">
      <Icon name={icon} />
    </span>
  )}
  <h3>{title}</h3>
  <p>{body}</p>
  <span class="card-go">{go} <Icon name="arrow-right-sm" /></span>
</a>
