---
// One scan code beside the support buttons. The codes show only on wide screens, where a phone
// is the other device in the room; on a phone the buttons above do the same job. `minor` draws the
// code smaller, for GitHub Sponsors beside the Buy Me a Coffee code, which leads.
import Icon from './Icon.astro';

interface Props {
  /** the QR icon, drawn inline as SVG */
  icon: 'qr-sponsors' | 'qr-coffee';
  caption: string;
  minor?: boolean;
}
const { icon, caption, minor = false } = Astro.props;
---
<figure class:list={{ 'qr-minor': minor }}>
  <Icon name={icon} />
  <figcaption>{caption}</figcaption>
</figure>
