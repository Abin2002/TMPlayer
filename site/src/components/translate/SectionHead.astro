---
// A band's heading block: the h2 the band is labelled by, and an optional line under it.
interface Props {
  /** the h2's id, which the band names in aria-labelledby */
  id: string;
  title: string;
  sub?: string;
}
const { id, title, sub } = Astro.props;
---
<div class="section-head" data-reveal>
  <div class="section-title">
    <h2 id={id}>{title}</h2>
    {sub && <p class="section-sub">{sub}</p>}
  </div>
</div>
