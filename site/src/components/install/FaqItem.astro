---
// One troubleshooting question. They share a details name, so opening one closes the others.
import Icon from '../Icon.astro';

interface Props { q: string }
---
<details class="faq-item" name="trouble">
          <summary>
            <span class="faq-q">{Astro.props.q}</span>
            <Icon name="faq-chevron" />
          </summary>
          <div class="faq-body"><p><slot /></p></div>
        </details>
