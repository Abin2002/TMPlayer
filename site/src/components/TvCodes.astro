---
// What to type into Downloader on a television: the short address first, the number code second
// (each a block with a copy button, app.js), and the note that the code works in Downloader only.
// The download page's TV card and the install page's TV step share it.
import { text } from '../i18n/t';

const t = (k: string) => text(Astro.locals.lang, k);
---
<div class="code-pair">
  <pre class="code"><code>tmplayer.org/apk</code></pre>
  <span class="code-pair-or">{t('download.or')}</span>
  <pre class="code"><code>3206503</code></pre>
</div>
<p class="code-note">{t('download.code_note')}</p>
