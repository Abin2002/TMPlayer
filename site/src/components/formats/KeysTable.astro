---
// A two-column table of what plays: one KeysRow per line, under the What and Plays headers.
import { text } from '../../i18n/t';
const t = (k: string) => text(Astro.locals.lang, k);
---
<div class="keys-wrap" data-reveal>
  <table class="keys">
    <thead>
      <tr><th scope="col">{t('formats.what')}</th><th scope="col">{t('formats.plays')}</th></tr>
    </thead>
    <tbody>
      <slot />
    </tbody>
  </table>
</div>
