---
// One band of the page: a section with its wrap and, when it has a title, the section head whose
// h2 the section is labelled by. A band without a title (the support card) carries its own h2
// with the `labelledby` id.
interface Props { id?: string; labelledby: string; tonal?: boolean; title?: string; sub?: string }
const { id, labelledby, tonal = false, title, sub } = Astro.props;
---
<section class:list={['band', { 'band-tonal': tonal }]} id={id} aria-labelledby={labelledby}>
  <div class="wrap">
    {title && (
      <div class="section-head" data-reveal>
        <div class="section-title">
          <h2 id={labelledby}>{title}</h2>
          <p class="section-sub">{sub}</p>
        </div>
      </div>
    )}
    <slot />
  </div>
</section>
