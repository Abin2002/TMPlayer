---
// The download bar on a phone: one line and one button at the bottom of the screen, which app.js
// slides in only once the reader has scrolled past the hero or the page head, and takes away again
// when they scroll back up to it, where the page's own buttons are. Closing it is remembered under
// tm-get-closed for every page and language. It is a bar and not a dialog: it never covers the
// page on arrival, never takes the focus, and the page gains room at the bottom while it shows, so
// the footer stays in reach. With scripting off it never appears, and the layout leaves it off the
// download and install pages, which are where it would lead.
import Icon from './Icon.astro';
import { buildString, text } from '../i18n/t';
import { l } from '../i18n/links';

const lang = Astro.locals.lang;
const close = buildString(lang, 'build.kao_close');
---
<aside class="get-bar" id="get-bar" aria-labelledby="get-bar-text" hidden>
  <p id="get-bar-text">{text(lang, 'common.get_tmplayer')}</p>
  <a class="btn btn-filled get-bar-go" href={l(lang, '/download/')}>{text(lang, 'common.download')}</a>
  <button type="button" class="get-bar-close" data-get-close aria-label={close} title={close}><Icon name="close" /></button>
</aside>
