---
// One numbered step. The id is the anchor the HowTo JSON-LD and other pages link to (#step-1,
// /fire-tv/#fire-1 and on), so it must not change. The step's paragraphs come in the slot; with
// `p` the slot is one sentence and the step wraps it in its paragraph.
interface Props { id?: string; title: string; p?: boolean }
const { id, title, p = false } = Astro.props;
---
<li id={id}>
  <h3>{title}</h3>
  {p ? <p><slot /></p> : <slot />}
</li>
