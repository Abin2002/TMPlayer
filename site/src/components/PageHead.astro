---
// The top of a page: the breadcrumb trail, the heading, the lede and, when the page has them, its
// buttons. The lede is the `lede` string or a "lede" slot (for one with markup). Anything after
// the buttons, such as the "on this page" links, goes in the default slot. `updated` is the page's
// English path, for an "Updated" line from its lastmod under the lede. An "aside" slot (the download
// page's devices) puts the words at the start and the aside beside them from 1080 px; under that
// the aside is not drawn and the head is centred as on every other page.
import Updated from './Updated.astro';

interface Props { lede?: string; updated?: string }
const { lede, updated } = Astro.props;
const split = Astro.slots.has('aside');
---
<section class:list={['page-head', { 'page-head-split': split }]}>
  <div class="wrap page-head-grid">
    <div class="page-head-wrap">
      <p class="crumbs"><slot name="crumbs" /></p>
      <h1><slot name="title" /></h1>
      <p class="page-lede">{lede}<slot name="lede" /></p>
      {updated && <Updated path={updated} />}
      {Astro.slots.has('actions') && (
        <div class="page-actions">
          <slot name="actions" />
        </div>
      )}
      <slot />
    </div>
    {split && <div class="page-head-aside"><slot name="aside" /></div>}
  </div>
</section>
