---
// The body of a policy page: an eyebrow, the one heading, then the ledes and sections as the slot.
interface Props { eyebrow: string; title: string }
const { eyebrow, title } = Astro.props;
---
<main id="main" class="policy-page">
  <div class="wrap policy-wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <slot />
  </div>
</main>
