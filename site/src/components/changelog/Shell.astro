---
// What every changelog page has around its <main>: the background art, the changelog header,
// the back to top button and the footer, inside the shared Base layout.
import Base from '../../layouts/Base.astro';
import BgArt from '../BgArt.astro';
import ToTop from '../ToTop.astro';
import ChangelogHeader from './ChangelogHeader.astro';
import ChangelogFooter from './ChangelogFooter.astro';

interface Props {
  path: string;
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
}
const { path, title, description, ogType = 'website', publishedTime } = Astro.props;
---
<Base path={path} title={title} description={description} ogType={ogType} publishedTime={publishedTime} feed>
  <Fragment slot="head"><slot name="head" /></Fragment>
<!-- Decorative background art, hidden from assistive technology and still under reduced motion. -->
<BgArt />

<ChangelogHeader />

<main id="main">
<slot />
</main>

<ToTop />

<ChangelogFooter />
</Base>
