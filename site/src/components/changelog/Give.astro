---
// The coffee and sponsor offer, in the download page's words. A release page is read by people
// who just got the update, which is the moment the offer makes the most sense.
import Icon from '../Icon.astro';
import { text } from '../../i18n/t';

interface Props { lead: string }
const t = (k: string) => text(Astro.locals.lang, k);
---
      <div class="support support-slim">
        <div class="support-more support-more-solo" id="sponsor">
          <h2 class="release-notes-h">{t('home.support_tmplayer')}</h2>
          <p>{Astro.props.lead} There are no ads of our own and no paid tier, so a coffee or a monthly sponsorship is what pays for the time each release takes. It is voluntary and unlocks nothing.</p>
          <div class="support-actions support-give">
            <a class="btn btn-filled" href="https://github.com/sponsors/dracu-lah" rel="noopener">
              <Icon name="heart-btn" />
              {t('home.sponsor_on_github')}
            </a>
            <a class="btn btn-outline" href="https://buymeacoffee.com/nevil.dev" rel="noopener">
              <Icon name="coffee-btn" />
              {t('home.buy_me_a_coffee')}
            </a>
          </div>
        </div>
      </div>
