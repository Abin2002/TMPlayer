---
// One band of a page: a section with its wrap and, when it has a title, the section head whose h2
// the section is labelled by (`labelledby`, by default `<id>-h`). A band without a title (a star
// card, the security report) carries its own h2 with that id. Tonal bands alternate with plain
// ones down the page.
//
// `wave` draws the wave that leads into the band first: a tonal band opens with the wave and a
// plain one with the flipped wave, so the colours meet along the curve. `body` wraps the content
// in the revealed section body. The sub line takes the `sub` string or a "sub" slot, and a "head"
// slot adds lines under it.
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  id?: string;
  labelledby?: string;
  title?: string;
  sub?: string;
  tonal?: boolean;
  wave?: boolean;
  body?: boolean;
}
const { id, title, sub, tonal = false, wave = false, body = false } = Astro.props;
const labelledby = Astro.props.labelledby ?? `${id}-h`;
const subHtml = Astro.slots.has('sub') ? await Astro.slots.render('sub') : '';
---
{wave && <Icon name={tonal ? 'wave' : 'wave-flip'} />}
<section class:list={['band', { 'band-tonal': tonal }]} id={id} aria-labelledby={labelledby}>
  <div class="wrap">
    {title !== undefined && (
      <SectionHead id={labelledby} title={title} sub={sub}>
        {subHtml && <Fragment slot="sub" set:html={subHtml} />}
        <slot name="head" />
      </SectionHead>
    )}
    {body ? <div class="section-body" data-reveal><slot /></div> : <slot />}
  </div>
</section>
