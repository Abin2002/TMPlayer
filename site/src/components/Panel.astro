---
// A panel: a heading over a list or over running text.
//
// With `kind` it is one side of a "what it is / what it is not" pair: a tick or a cross beside the
// heading and a list of the same marks. `icon`, `tone` and `list` set the same three parts one by
// one (the features page heads its ticked lists with a play or a search icon). `compact` writes the
// heading as the guides do, with no space around the icon and the words in their own span.
// Without a list it is a prose panel, its paragraphs in the slot; `wide` spans the whole band.
import Icon from './Icon.astro';

interface Props {
  title: string;
  kind?: 'yes' | 'no';
  icon?: string;
  tone?: string;
  list?: 'ticks' | 'crosses';
  compact?: boolean;
  wide?: boolean;
  id?: string;
}
const { title, kind, compact = false, wide = false, id } = Astro.props;
const yes = kind === 'yes';
const icon = Astro.props.icon ?? (kind && (yes ? 'tick-panel' : 'cross-panel'));
const tone = Astro.props.tone ?? kind;
const list = Astro.props.list ?? (kind && (yes ? 'ticks' : 'crosses'));
---
{list ? (
  <div class="panel" id={id}>
    {compact ? (
      <h3><span class={`panel-icon icon-${tone}`} aria-hidden="true"><Icon name={icon!} /></span><span>{title}</span></h3>
    ) : (
      <h3> <span class={`panel-icon icon-${tone}`} aria-hidden="true">
          <Icon name={icon!} />
        </span> {title}</h3>
    )}
    <ul class={list}>
      <slot />
    </ul>
  </div>
) : (
  <div class:list={['panel', 'panel-prose', { 'panel-wide': wide }]} id={id}>
    <h3>{title}</h3>
    <slot />
  </div>
)}
