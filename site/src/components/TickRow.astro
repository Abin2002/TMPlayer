---
// A row of short facts, each with a tick: the answers a visitor wants under a page's heading (free,
// open source, which systems, which version). `items` are the finished strings.
import Icon from './Icon.astro';

interface Props { items: string[] }
const { items } = Astro.props;
---
<ul class="quick-facts">
  {items.map((item) => <li><span class="quick-tick" aria-hidden="true"><Icon name="tick-panel" /></span>{item}</li>)}
</ul>
