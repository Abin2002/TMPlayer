---
// One troubleshooting question. Every item shares the same `name`, so the browser keeps only one
// open at a time (exclusive <details>), with no script involved.
import Icon from '../Icon.astro';

interface Props { q: string; name?: string }
const { q, name = 'trouble' } = Astro.props;
---
<details class="faq-item" name={name}>
  <summary>
    <span class="faq-q">{q}</span>
    <Icon name="faq-chevron" />
  </summary>
  <div class="faq-body"><p><slot /></p></div>
</details>
