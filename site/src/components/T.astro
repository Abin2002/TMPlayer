---
// A catalog string in the page's language. Inline markup inside the sentence comes in as named
// slots matching the string's {placeholders}:
//
//   <T k="home.quiet"><a slot="a1" href={l('/install/')}><T k="home.quiet__a1"/></a></T>
//
// Plain {name} placeholders can be filled from `vars` instead.
import { escapeHtml, text } from '../i18n/t';

interface Props { k: string; vars?: Record<string, string | number> }
const { k, vars = {} } = Astro.props;
const tmpl = text(Astro.locals.lang, k);
let html = '';
let pos = 0;
for (const m of tmpl.matchAll(/\{(\w+)\}/g)) {
  html += escapeHtml(tmpl.slice(pos, m.index));
  const name = m[1];
  if (Astro.slots.has(name)) html += await Astro.slots.render(name);
  else if (name in vars) html += escapeHtml(String(vars[name]));
  else html += m[0];
  pos = m.index! + m[0].length;
}
html += escapeHtml(tmpl.slice(pos));
---
<Fragment set:html={html} />
