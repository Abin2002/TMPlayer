---
// The Keep Android Open notice. Its markup is in the page, so nothing shifts once it loads; the
// theme script in the head hides it before the first paint once the reader closed it, and app.js
// wires the close button. Nothing is loaded from the campaign's site.
import Icon from './Icon.astro';
import { buildString } from '../i18n/t';
import { KAO_URL } from '../i18n/langs';
const lang = Astro.locals.lang;
const close = buildString(lang, 'build.kao_close');
---
<aside class="kao" id="kao" aria-label="Keep Android Open">
  <div class="kao-bar"><p><span>{buildString(lang, 'build.kao_bar')}</span> <a href={KAO_URL} target="_blank" rel="noopener">{buildString(lang, 'build.kao_learn')}</a></p><button type="button" class="kao-close" data-kao-close aria-label={close} title={close}><Icon name="close" /></button></div>
</aside>
