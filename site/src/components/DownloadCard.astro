---
// The download offer that closes a page with no download button of its own (/fire-tv/, /formats/,
// /translate/ and the guides): a support-slim card like the "Support TMPlayer" one it sits
// above, so the last band ends on the two things a reader can do next, get the app or support it.
// It is written in strings the site already has, the download page's heading and lede, so it
// arrives translated. `more` adds an outline link after the button: by default the install steps,
// or the page's own better next step (the Fire TV page's step by step guide); `more={false}` leaves
// it out.
import Icon from './Icon.astro';
import { text } from '../i18n/t';
import { l } from '../i18n/links';

interface Props { more?: { href: string; label: string } | false }
const lang = Astro.locals.lang;
const t = (k: string) => text(lang, k);
const more = Astro.props.more ?? { href: l(lang, '/install/'), label: t('download.how_to_install_it') };
---
<div class="support support-slim get-card" data-reveal>
  <div class="support-more support-more-solo">
    <h3>{t('home.download_tmplayer')}</h3>
    <p>{t('download.for_android_tv_phones_windows')}</p>
    <div class="support-actions">
      <a class="btn btn-filled" href={l(lang, '/download/')}><Icon name="download-btn" /> {t('common.download')}</a>
      {more && <a class="btn btn-outline" href={more.href}>{more.label} <Icon name="arrow-right-sm" /></a>}
    </div>
  </div>
</div>
