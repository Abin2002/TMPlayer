---
// A screenshot in its drawn device, with its caption in the slot (it carries inline markup).
import Device, { type DeviceKind } from './Device.astro';
import Shot, { type ShotProps } from './Shot.astro';
import { deviceSizes } from './shot-sizes';

interface Props { device: DeviceKind; shot: ShotProps }
const { device, shot } = Astro.props;
---
<figure class="shot" data-reveal>
  <Device kind={device}>
    <Shot sizes={deviceSizes(device)} {...shot} />
  </Device>
  <figcaption><slot /></figcaption>
</figure>
