---
// A card: a heading and one paragraph, the paragraph as `body` or in the slot. On top it can carry
// a screenshot (`shot`, with its light twin where there is one, cropped to 2:1 by
// scripts/annotate-shot.py) or a large icon in the screenshot's place (`shotIcon`), so the headings
// of a row line up whichever kind each card is.
import Icon from './Icon.astro';
import Shot, { type ShotProps } from './Shot.astro';

interface Props { title: string; body?: string; shot?: ShotProps; shotIcon?: string }
const { title, body, shot, shotIcon } = Astro.props;
---
<div class="card">
  {shot && <Shot {...shot} frame="card-shot" />}
  {shotIcon && (
    <span class="card-shot card-shot-icon" aria-hidden="true">
      <Icon name={shotIcon} />
    </span>
  )}
  <h3>{title}</h3>
  <p>{body ?? <slot />}</p>
</div>
