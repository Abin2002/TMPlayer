---
// One question of an accordion, the answer in the slot. Every item of one accordion shares the
// same `name`, so the browser keeps only one open at a time (exclusive <details>), with no script
// involved. The troubleshooting lists use "trouble", the questions page "faq".
import Icon from './Icon.astro';

interface Props { q: string; name?: string; id?: string }
const { q, name = 'trouble', id } = Astro.props;
---
<details class="faq-item" name={name} id={id}>
  <summary>
    <span class="faq-q">{q}</span>
    <Icon name="faq-chevron" />
  </summary>
  <div class="faq-body"><p><slot /></p></div>
</details>
