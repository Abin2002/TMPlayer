---
// One line of "What it does" as a tile: its lead words (the {strong1} slot, kept under the line's
// own key with `__strong1`) and the rest, with a cropped screenshot over it where one shows the
// thing. `extra` marks a tile a phone folds away behind the group's "Show the other" button.
import T from '../T.astro';
import Shot, { type ShotProps } from '../Shot.astro';
import { SHOT_FEAT } from '../shot-sizes';
import { text } from '../../i18n/t';

interface Props { k: string; shot?: ShotProps; extra?: boolean }
const { k, shot, extra = false } = Astro.props;
const t = (key: string) => text(Astro.locals.lang, key);
---
<li class:list={['feat', { 'feat-has-shot': shot, 'feat-extra': extra }]}>
  {shot && <Shot frame="feat-shot" sizes={SHOT_FEAT} {...shot} alt={t(shot.alt)} />}
  <p><T k={k}><strong slot="strong1">{t(`${k}__strong1`)}</strong></T></p>
</li>
