---
// A screenshot with numbered marks laid over it in CSS, so the marks stay sharp and the notes stay
// translatable. Each point carries its mark's position and its note together, so mark N and line N
// of the list can never drift apart. --x and --y are percentages of the screenshot itself,
// measured on the full size file, so they hold at any size.
import Device from '../Device.astro';
import Shot from '../Shot.astro';
import type { Screen } from './GalleryShot.astro';
import { text } from '../../i18n/t';

export interface Point { x: string; y: string; note: string }
interface Props { id: string; shot: Screen; title: string; lede: string; points: Point[] }
const { id, shot, title, lede, points } = Astro.props;
const t = (k: string) => text(Astro.locals.lang, k);
---
<figure class="shot tour-shot" id={id} data-reveal>
  <Device kind={shot.device}>
    <Shot src={shot.src} light={shot.light} alt={t(shot.alt)} width={shot.width} height={shot.height} />
    <div class="tour-marks" aria-hidden="true">
      {points.map((p) => <span style={`--x: ${p.x}; --y: ${p.y}`}></span>)}
    </div>
  </Device>
  <figcaption>
    <h3>{t(title)}</h3>
    <p>{t(lede)}</p>
    <ol class="tour-list">
      {points.map((p) => <li>{t(p.note)}</li>)}
    </ol>
  </figcaption>
</figure>
