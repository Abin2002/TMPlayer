---
// A panel of ticked lines under an icon heading. Each line is a catalog string whose lead words
// come in as the {strong1} slot, kept under the line's own key with `__strong1`.
import T from '../T.astro';
import Icon from '../Icon.astro';
import { text } from '../../i18n/t';

interface Props { icon: string; tone: 'play' | 'browse'; title: string; items: string[] }
const { icon, tone, title, items } = Astro.props;
const t = (k: string) => text(Astro.locals.lang, k);
---
<div class="panel">
  <h3> <span class={`panel-icon icon-${tone}`} aria-hidden="true">
      <Icon name={icon} />
    </span> {t(title)}</h3>
  <ul class="ticks">
    {items.map((k) => (
      <li><T k={k}><strong slot="strong1">{t(`${k}__strong1`)}</strong></T></li>
    ))}
  </ul>
</div>
