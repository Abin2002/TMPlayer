---
// A screenshot in its device with a caption whose bold lead comes in as the {b1} slot, kept under
// the caption's own key with `__b1`.
import T from '../T.astro';
import DeviceShot from '../DeviceShot.astro';
import type { DeviceKind } from '../Device.astro';
import { text } from '../../i18n/t';

export interface Screen {
  device: DeviceKind;
  src: string;
  light?: string;
  alt: string;
  width: number;
  height: number;
}
interface Props { shot: Screen; caption: string }
const { shot, caption } = Astro.props;
const t = (k: string) => text(Astro.locals.lang, k);
---
<DeviceShot device={shot.device} shot={{ src: shot.src, light: shot.light, alt: t(shot.alt), width: shot.width, height: shot.height }}><T k={caption}><b slot="b1">{t(`${caption}__b1`)}</b></T></DeviceShot>
