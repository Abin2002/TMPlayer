---
// A band's heading block: the h2 (with the id its section is labelled by) and an optional line
// under it. Extra lines go in the default slot.
import { text } from '../../i18n/t';

interface Props { id: string; title: string; sub?: string }
const { id, title, sub } = Astro.props;
const t = (k: string) => text(Astro.locals.lang, k);
---
<div class="section-head" data-reveal>
  <div class="section-title">
    <h2 id={id}>{t(title)}</h2>
    {sub && <p class="section-sub">{t(sub)}</p>}
    <slot />
  </div>
</div>
