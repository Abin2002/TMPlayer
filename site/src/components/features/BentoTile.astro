---
// One tile of the features page's bento of screens: a screenshot and its caption, whose bold lead
// comes in as the {b1} slot, kept under the caption's own key with `__b1`. A wide tile spans two
// of the three columns and holds a television or a computer; a tall one spans two rows and holds a
// phone in its drawn frame. `start` puts a tall tile in the first column. On a phone the tiles
// become one row that scrolls sideways (styles.css, `.bento`).
import T from '../T.astro';
import Device from '../Device.astro';
import Shot from '../Shot.astro';
import type { Screen } from './GalleryShot.astro';
import { SHOT_BENTO_TALL, SHOT_BENTO_WIDE } from '../shot-sizes';
import { text } from '../../i18n/t';

interface Props { shot: Screen; caption: string; start?: boolean }
const { shot, caption, start = false } = Astro.props;
const t = (k: string) => text(Astro.locals.lang, k);
const tall = shot.device === 'phone';
---
<figure class:list={['bento-tile', tall ? 'bento-tall' : 'bento-wide', { 'bento-start': start }]}>
  <div class="bento-media">
    {tall ? (
      <Device kind="phone"><Shot src={shot.src} light={shot.light} alt={t(shot.alt)} width={shot.width} height={shot.height} sizes={SHOT_BENTO_TALL} /></Device>
    ) : (
      <Shot frame="bento-frame" src={shot.src} light={shot.light} alt={t(shot.alt)} width={shot.width} height={shot.height} sizes={SHOT_BENTO_WIDE} />
    )}
  </div>
  <figcaption><T k={caption}><b slot="b1">{t(`${caption}__b1`)}</b></T></figcaption>
</figure>
