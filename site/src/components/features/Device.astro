---
// A drawn device around a screenshot: a phone, a television on its stand, a desktop monitor (the
// television's frame with the desktop proportions), or a plain frame for a cropped shot. The
// default slot goes inside the screen.
interface Props { kind: 'phone' | 'tv' | 'desktop' | 'frame' }
const { kind } = Astro.props;
const cls = {
  phone: 'device device-phone',
  tv: 'device device-tv',
  desktop: 'device device-tv device-desktop',
  frame: 'frame',
}[kind];
const stand = kind === 'tv' || kind === 'desktop';
---
<div class={cls}>
  <div class="screen">
    <slot />
  </div>
  {stand && <div class="stand"></div>}
  {stand && <div class="foot"></div>}
</div>
