---
// A panel headed by a tick or a cross, over a list of the same marks: what it is, what it is not.
import Icon from '../Icon.astro';

interface Props { kind: 'yes' | 'no'; title: string }
const { kind, title } = Astro.props;
---
<div class="panel">
  <h3> <span class={`panel-icon icon-${kind}`} aria-hidden="true">
      <Icon name={kind === 'yes' ? 'tick-panel' : 'cross-panel'} />
    </span> {title}</h3>
  <ul class={kind === 'yes' ? 'ticks' : 'crosses'}>
    <slot />
  </ul>
</div>
