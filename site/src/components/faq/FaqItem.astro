---
// One question of the accordion. `q` and `a` are catalog keys; with `href` the answer's {a1}
// placeholder becomes a link whose words are the `a__a1` string.
import T from '../T.astro';
import Icon from '../Icon.astro';
import { text } from '../../i18n/t';

interface Props { q: string; a: string; href?: string; id?: string }
const { q, a, href, id } = Astro.props;
const t = (k: string) => text(Astro.locals.lang, k);
---
<details class="faq-item" name="faq" id={id}>
  <summary>
    <span class="faq-q">{t(q)}</span>
    <Icon name="faq-chevron" />
  </summary>
  <div class="faq-body"><p>{href ? <T k={a}><a href={href} slot="a1">{t(`${a}__a1`)}</a></T> : t(a)}</p></div>
</details>
