---
// The question a stranger's APK raises before any other: what it does with your account. Four
// plain answers on the start side and the proof on the end side: the TV's Chats screen, which
// lists chats and never a message. The FAQ has the long version.
import Icon from '../Icon.astro';
import Device from '../Device.astro';
import Shot from '../Shot.astro';
import { SHOT_HOME_TRUST } from '../shot-sizes';
import { text } from '../../i18n/t';
import { l as link } from '../../i18n/links';

const lang = Astro.locals.lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);
const points = [
  { icon: 'spec-sign-in', h: t('home.trust_account_h'), p: t('home.trust_account') },
  { icon: 'shield-btn', h: t('home.trust_server_h'), p: t('home.trust_server') },
  { icon: 'play-card', h: t('home.trust_videos_h'), p: t('home.trust_videos') },
  { icon: 'spec-costs', h: t('home.trust_free_h'), p: t('home.trust_free') },
];
---
<section class="band trust" id="privacy" aria-labelledby="trust-h">
  <div class="wrap">
    <div class="trust-split trust-panel">
      <div class="trust-words" data-reveal>
        <h2 id="trust-h">{t('home.trust_h')}</h2>
        <p class="section-sub">{t('home.trust_sub')}</p>
        <ul class="trust-list">
          {points.map((p) => (
            <li>
              <span class="trust-icon" aria-hidden="true"><Icon name={p.icon} /></span>
              <div>
                <h3>{p.h}</h3>
                <p>{p.p}</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="trust-note">{t('home.trust_note')} <a class="inline-link" href={l('/faq/')}>{t('home.questions_and_limits')} <Icon name="arrow-right-sm" /></a></p>
      </div>
      <div class="trust-shot" data-reveal>
        <Device kind="tv">
          <Shot src="/screenshots/tv-chats.webp" light="/screenshots/tv-chats-light.webp" alt={t('home.tv_chats_alt')} width="1920" height="1080" sizes={SHOT_HOME_TRUST} />
        </Device>
      </div>
    </div>
  </div>
</section>
