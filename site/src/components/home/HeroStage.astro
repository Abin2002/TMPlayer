---
// The hero's picture: Home on the television at the back, and three phones fanned over its lower
// edge (the chat list, a chat's posters, a show's page), so the first screen shows the same
// account on both and more of the app than one frame can.
//
// The television is the largest paint, so it alone asks for priority. The phones are on the first
// screen too and load eagerly, without it. The fan opens once as the page arrives and then the
// phones stay still; with a mouse, app.js turns the stage a few degrees toward the pointer. Under
// reduced motion the phones are drawn already fanned and nothing moves (styles.css, home block).
import Device from '../Device.astro';
import Shot from '../Shot.astro';
import { SHOT_HERO_TV, SHOT_HERO_PHONE } from '../shot-sizes';
import { text } from '../../i18n/t';

const t = (k: string) => text(Astro.locals.lang, k);
const phones = [
  { cls: 'fan-l', src: 'phone-chats', alt: t('home.phone_chats_alt') },
  { cls: 'fan-r', src: 'phone-grid', alt: t('home.phone_grid_alt') },
  { cls: 'fan-c', src: 'phone-show', alt: t('home.phone_show_page_alt') },
];
---
<figure class="hstage" data-stage>
  <div class="hstage-tilt">
    <div class="hstage-tv">
      <Device kind="tv">
        <Shot src="/screenshots/tv-home.webp" light="/screenshots/tv-home-light.webp" alt={t('home.tv_home_hero_alt')} width="1920" height="1080" sizes={SHOT_HERO_TV} fetchpriority="high" lazy={false} />
      </Device>
    </div>
    {phones.map((p) => (
      <div class:list={['fan-slot', p.cls]}>
        <Device kind="phone">
          <Shot src={`/screenshots/${p.src}.webp`} light={`/screenshots/${p.src}-light.webp`} alt={p.alt} width="1080" height="2400" sizes={SHOT_HERO_PHONE} lazy={false} />
        </Device>
      </div>
    ))}
  </div>
</figure>
