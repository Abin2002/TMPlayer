---
// What happens after you press play, in five tiles with the screen that proves each one: the player
// and its timebar, a show's page, a chat's posters, the next episode card and a search that forgives
// a typo.
//
// Three columns from 1080 px (the player across two beside the show's page, then the other three in
// a row), two from 700 px (the player across both, then two pairs), one under that. Every tile is the
// same: its picture on top, then its title and its words, on one inner padding. The player's
// timebar is laid over the foot of its shot at twice the size, a loupe on the part of the screen the
// tile is about (one small file, so it has no srcset). Every picture is below the fold, so all of
// them load lazily.
import Icon from '../Icon.astro';
import Shot from '../Shot.astro';
import SectionHead from '../SectionHead.astro';
import { SHOT_HOME_WIDE, SHOT_HOME_CELL } from '../shot-sizes';
import { text } from '../../i18n/t';
import { l as link } from '../../i18n/links';

const lang = Astro.locals.lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);
---
<section class="band hbento-band" id="what" aria-labelledby="what-h">
  <div class="wrap">
    <SectionHead id="what-h" title={t('home.bento_h')} sub={t('home.bento_sub')} />
    <ul class="hbento" data-reveal>
      <li class="hcell hcell-stream">
        <div class="hcell-media">
          <Shot src="/screenshots/desktop-player.webp" alt={t('features.the_tmplayer_desktop_player_over')} width="1920" height="1200" sizes={SHOT_HOME_WIDE} frame="hcell-pic" />
          <Shot src="/screenshots/desktop-player-timebar.webp" alt={t('home.player_timebar_alt')} width="600" height="120" frame="hloupe" />
        </div>
        <div class="hcell-text">
          <h3>{t('home.cell_stream_h')}</h3>
          <p>{t('home.cell_stream')}</p>
        </div>
      </li>
      <li class="hcell hcell-series">
        <div class="hcell-media">
          <Shot src="/screenshots/phone-show-season.webp" light="/screenshots/phone-show-season-light.webp" alt={t('home.phone_show_season_alt')} width="1080" height="1380" sizes={SHOT_HOME_CELL} frame="hcell-pic" />
        </div>
        <div class="hcell-text">
          <h3>{t('home.cell_series_h')}</h3>
          <p>{t('home.cell_series')}</p>
        </div>
      </li>
      <li class="hcell hcell-files">
        <div class="hcell-media">
          <Shot src="/screenshots/phone-grid-rows.webp" light="/screenshots/phone-grid-rows-light.webp" alt={t('home.phone_grid_rows_alt')} width="1080" height="1310" sizes={SHOT_HOME_CELL} frame="hcell-pic" />
        </div>
        <div class="hcell-text">
          <h3>{t('home.cell_files_h')}</h3>
          <p>{t('home.cell_files')}</p>
        </div>
      </li>
      <li class="hcell hcell-resume">
        <div class="hcell-media">
          <Shot src="/screenshots/tv-next-episode.webp" alt={t('android_tv.next_episode_shot_alt')} width="840" height="420" sizes={SHOT_HOME_CELL} frame="hcell-pic" />
        </div>
        <div class="hcell-text">
          <h3>{t('home.cell_resume_h')}</h3>
          <p>{t('home.cell_resume')}</p>
        </div>
      </li>
      <li class="hcell hcell-search">
        <div class="hcell-media">
          <Shot src="/screenshots/tv-search.webp" light="/screenshots/tv-search-light.webp" alt={t('android_tv.search_shot_alt')} width="960" height="480" sizes={SHOT_HOME_CELL} frame="hcell-pic" />
        </div>
        <div class="hcell-text">
          <h3>{t('home.cell_search_h')}</h3>
          <p>{t('home.cell_search')}</p>
        </div>
      </li>
    </ul>
    <p class="hbento-more" data-reveal><a class="inline-link" href={l('/features/')}>{t('home.every_feature')} <Icon name="arrow-right-sm" /></a></p>
  </div>
</section>
