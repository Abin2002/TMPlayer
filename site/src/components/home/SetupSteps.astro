---
// Setup, as a short timeline: three columns joined by a line from 1080 px, a column with the line
// running down under that. The TV step carries the address to type, since typing it is the whole
// of that step, and the last one keeps the QR sign-in screen.
import Icon from '../Icon.astro';
import Shot from '../Shot.astro';
import SectionHead from '../SectionHead.astro';
import { SHOT_STEP } from '../shot-sizes';
import { text } from '../../i18n/t';
import { l as link } from '../../i18n/links';

const lang = Astro.locals.lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);
---
<section class="band setup" id="start" aria-labelledby="start-h">
  <div class="wrap">
    <SectionHead id="start-h" title={t('home.set_up_in_three_steps')} sub={t('home.you_do_it_once_then')} />
    <ol class="htimeline" data-reveal>
      <li>
        <h3>{t('home.get_the_file')}</h3>
        <p>{t('home.get_the_file_all')}</p>
        <p><a class="inline-link" href={l('/download/')}>{t('home.go_to_the_download_page')} <Icon name="arrow-right-sm" /></a></p>
      </li>
      <li>
        <h3>{t('home.install_it')}</h3>
        <p>{t('home.install_it_each')}</p>
        <p class="tl-codes"><code class="tl-code">tmplayer.org/apk</code></p>
        <p><a class="inline-link" href={l('/install/')}>{t('home.read_the_install_steps')} <Icon name="arrow-right-sm" /></a></p>
      </li>
      <li>
        <h3>{t('home.scan_the_qr_code')}</h3>
        <p>{t('home.step_sign_in')}</p>
        <Shot src="/screenshots/tv-sign-in.webp" light="/screenshots/tv-sign-in-light.webp" alt={t('home.sign_in_qr_alt')} width="960" height="480" sizes={SHOT_STEP} frame="step-shot" />
      </li>
    </ol>
    <p class="steps-cta" data-reveal><a class="btn btn-filled" href={l('/download/')}><Icon name="download-sm" /> {t('home.download_tmplayer')}</a></p>
  </div>
</section>
