---
// The four doubts that stop an install, answered in a line each, before the page asks for a star.
// Native <details>, so the answers are in the HTML, open with a keyboard and need no script. No
// FAQPage data here: the questions page carries that, and two pages claiming it compete.
import Icon from '../Icon.astro';
import FaqItem from '../FaqItem.astro';
import { text } from '../../i18n/t';
import { l as link } from '../../i18n/links';

const lang = Astro.locals.lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);
const items = [
  [t('home.faq_free_q'), t('home.faq_free_a')],
  [t('home.faq_official_q'), t('home.faq_official_a')],
  [t('home.faq_see_q'), t('home.faq_see_a')],
  [t('home.faq_fire_q'), t('home.faq_fire_a')],
];
---
<section class="band faq-teaser" id="questions" aria-labelledby="questions-h">
  <div class="wrap">
    <div class="faq-teaser-split">
      <div class="faq-teaser-head" data-reveal>
        <h2 id="questions-h">{t('home.faq_h')}</h2>
        <p><a class="inline-link" href={l('/faq/')}>{t('home.faq_all')} <Icon name="arrow-right-sm" /></a></p>
      </div>
      <div class="faq faq-teaser-list" data-reveal>
        {items.map(([q, a]) => <FaqItem q={q} name="home">{a}</FaqItem>)}
      </div>
    </div>
  </div>
</section>
