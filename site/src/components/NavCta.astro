---
// The Download button in every header, the one way to the files that is on screen from the first
// paint of every page. It stands in for the Download link of the page list wherever the bar has
// room for it; on a phone it gives its place back to that link, which closes the menu card as a
// filled row (styles.css, "The Download button"). On the download page it stays, so the header
// does not change shape between pages, but as the current page rather than as a call to action.
import Icon from './Icon.astro';

interface Props { href: string; label: string; current?: boolean }
const { href, label, current = false } = Astro.props;
---
<a class="nav-cta" href={href} aria-current={current ? 'page' : undefined}><Icon name="download-sm" /><span>{label}</span></a>
