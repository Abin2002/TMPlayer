<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- A window background in the theme's own colour, so nothing flashes before Compose draws -->
    <style name="Theme.TMPlayer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
    </style>

    <!--
      The phone's player: a plain full-screen dark window. The television overrides this with
      leanback's own theme in res/values-television, which is where the transport row reads its
      styling from. Running a phone on Theme.Leanback gave it the 10-foot control metrics and a
      window that knows nothing about a cutout.
    -->
    <style name="Theme.TMPlayer.Player" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <!--
      The player's error sheet buttons, in the pill the player's own worded controls sit on
      (bg_control_pill) rather than the platform's grey capitals: sentence case, medium weight,
      white on the dark seat and dark on white under focus.
    -->
    <style name="PlayerSheetButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_control_pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/player_control_icon</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">200dp</item>
        <item name="android:paddingLeft">28dp</item>
        <item name="android:paddingRight">28dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="PlayerSheetButton.Primary">
        <item name="android:background">@drawable/bg_control_pill_primary</item>
        <item name="android:textColor">@color/player_primary_text</item>
    </style>
</resources>
