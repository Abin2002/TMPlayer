<!--
  The dark the bottom cluster reads against: black at 80 per cent at the edge, 60 per cent at
  half height where the times and the television's title sit, so white text holds AA contrast on
  a snow scene, and clear at the top so the picture is never dimmed wholesale.

  This is the three-stop stand-in the layout names. PlayerControls replaces it with
  ControlsScrim.bottom(), the same fade on five stops, which XML cannot draw without a seam.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="90"
        android:startColor="#CC000000"
        android:centerColor="#99000000"
        android:endColor="#00000000" />
</shape>
