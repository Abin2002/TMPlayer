<!--
  The seat the player's round buttons share: black at half strength with a 1dp edge of white at
  16 per cent, in a pill. Over a bright frame the group still reads as one control, and the white
  circle a focused button fills with (bg_control_button) stands clear of it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#80000000" />
    <stroke
        android:width="1dp"
        android:color="#29FFFFFF" />
    <corners android:radius="100dp" />
</shape>
